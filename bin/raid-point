#!/usr/bin/env python3
"""Raid Point - orquestre agentes de IA em terminais por projeto (GTK4 + VTE + tmux)."""
import gi, json, os, sys, subprocess, hashlib, shlex, re, shutil, threading, time
gi.require_version("Gtk", "4.0")
gi.require_version("Vte", "3.91")
from gi.repository import Gtk, Vte, GLib, Gdk, Gio, Pango

_AQUI = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(_AQUI, ".."))
from raidpoint import core
RAIDPOINT = os.path.join(_AQUI, "raidpoint")

CFG = str(core.CFG)
DB = os.path.join(CFG, "projects.json")
TMUX = core.TMUX
FONT = "Noto Sans Mono 11"
PALETA = ["#cba6f7", "#89b4fa", "#a6e3a1", "#f9e2af", "#fab387", "#f38ba8", "#94e2d5", "#74c7ec"]

def load():
    try: return json.load(open(DB))
    except Exception: return {}

def save(d):
    os.makedirs(CFG, exist_ok=True)
    json.dump(d, open(DB, "w"), indent=2, ensure_ascii=False)

def agentes():
    try: return json.load(open(os.path.join(CFG, "agents.json")))
    except Exception: return [{"name": "Shell", "cmd": ""}]

def tmux(*a):
    return subprocess.run(TMUX + list(a), text=True, capture_output=True)

CM = str(core.CM)

def ssh_hosts():
    hs = []
    try:
        for l in open(os.path.expanduser("~/.ssh/config")):
            m = re.match(r"\s*Host\s+(.+)", l, re.I)
            if m:
                hs += [h for h in m.group(1).split() if not re.search(r"[*?!]", h) and h != "github.com"]
    except Exception: pass
    return sorted(set(hs))

def remote_argv(name, p):
    """comando que conecta (mosh/ssh) à sessão tmux do projeto remoto"""
    tm = ["tmux", "new-session", "-A", "-s", name] + (["-c", p["dir"]] if p.get("dir") else []) + \
         [";", "set", "-g", "mouse", "on", ";", "set", "-g", "allow-set-title", "off",
          ";", "set", "-g", "pane-border-status", "top",
          ";", "set", "-g", "pane-border-format", " #{pane_title} "]
    if p.get("transport", "mosh") == "mosh" and shutil.which("mosh"):
        return ["mosh", p["host"], "--"] + tm
    return ["ssh", "-t", p["host"], shlex.join(tm)]

def run_tmux(name, *a):
    """roda um comando tmux na sessão do projeto (local, ou na VPS via ssh)"""
    p = load().get(name, {})
    if p.get("host"):
        cmd = ["ssh", "-o", "ControlMaster=auto", "-o", f"ControlPath={CM}/cm-%C", "-o", "ControlPersist=120",
               "-o", "BatchMode=yes", p["host"], shlex.join(["tmux", *a])]
        try: return subprocess.run(cmd, text=True, capture_output=True, timeout=15)
        except Exception as e: return subprocess.CompletedProcess(cmd, 1, "", str(e))
    return tmux(*a)

def pdir(name):
    p = load().get(name, {})
    return p.get("dir") if p.get("host") else os.path.expanduser(p.get("dir", "~"))

def alive():
    r = tmux("list-sessions", "-F", "#{session_name}")
    return set(r.stdout.split()) if r.returncode == 0 else set()

def cor(nome):
    return PALETA[int(hashlib.md5(nome.encode()).hexdigest(), 16) % len(PALETA)]

CSS = """
