def git_summary(d, pr_cache, key):
    r = subprocess.run(["git", "-C", d, "status", "--porcelain=v1", "-b"], text=True, capture_output=True)
    if r.returncode != 0: return ""
    lines = r.stdout.splitlines(); head = lines[0][3:] if lines else ""
    branch = head.split("...")[0]
    m = re.search(r"\[(.*?)\]", head); sync = ""
    if m:
        a = re.search(r"ahead (\d+)", m.group(1)); b = re.search(r"behind (\d+)", m.group(1))
        sync = (f"  ↑{a.group(1)}" if a else "") + (f"  ↓{b.group(1)}" if b else "")
    dirty = len(lines) - 1
    txt = f"⎇ {branch}" + (f"  ● {dirty} changed" if dirty else "  ✓ clean") + sync
    ts, pr = pr_cache.get(key, (0, ""))
    if time.time() - ts > 60:
        pr = ""
        if shutil.which("gh"):
            g = subprocess.run(["gh", "pr", "view", "--json", "number,statusCheckRollup"], cwd=d, text=True,
                               capture_output=True, timeout=12)
            if g.returncode == 0:
                try:
                    j = json.loads(g.stdout); st = [c.get("conclusion") or c.get("status") for c in j.get("statusCheckRollup") or []]
                    ic = "✗" if any(x in ("FAILURE", "ERROR") for x in st) else ("…" if any(x in ("IN_PROGRESS", "QUEUED", "PENDING", None) for x in st) else "✓")
                    pr = f"  PR #{j['number']} {ic if st else ''}"
                except Exception: pass
        pr_cache[key] = (time.time(), pr)
    return txt + pr

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=os.environ.get("RAIDPOINT_APPID", "br.com.satela.DevRaid"))
        self.terms, self.rows, self.cur = {}, {}, None
        self.cfg = core.load_config()
        self.rebuild_binds()
        try: self.zoom = float(load().get("_zoom", 1.0))
        except Exception: self.zoom = 1.0
        self._spawn_t = {}; self._respawn = set(); self._cloning = set(); self._av_css = set()

    def do_activate(self):
        if getattr(self, "win", None):          # app already open: just raise the window (don't duplicate window and timers)
            self.win.present(); return
