def git_summary(d, pr_cache, key):
    r = subprocess.run(["git", "-C", d, "status", "--porcelain=v1", "-b"], text=True, capture_output=True)
    if r.returncode != 0: return ""
    lines = r.stdout.splitlines(); head = lines[0][3:] if lines else ""
    branch = head.split("...")[0]
    m = re.search(r"\[(.*?)\]", head); sync = ""
    if m:
        a = re.search(r"ahead (\d+)", m.group(1)); b = re.search(r"behind (\d+)", m.group(1))
        sync = (f"  ↑{a.group(1)}" if a else "") + (f"  ↓{b.group(1)}" if b else "")
    dirty = len(lines) - 1
    txt = f"⎇ {branch}" + (f"  ● {dirty} alterado{'s' if dirty != 1 else ''}" if dirty else "  ✓ limpo") + sync
    ts, pr = pr_cache.get(key, (0, ""))
    if time.time() - ts > 60:
        pr = ""
        if shutil.which("gh"):
            g = subprocess.run(["gh", "pr", "view", "--json", "number,statusCheckRollup"], cwd=d, text=True,
                               capture_output=True, timeout=12)
            if g.returncode == 0:
                try:
                    j = json.loads(g.stdout); st = [c.get("conclusion") or c.get("status") for c in j.get("statusCheckRollup") or []]
                    ic = "✗" if any(x in ("FAILURE", "ERROR") for x in st) else ("…" if any(x in ("IN_PROGRESS", "QUEUED", "PENDING", None) for x in st) else "✓")
                    pr = f"  PR #{j['number']} {ic if st else ''}"
                except Exception: pass
        pr_cache[key] = (time.time(), pr)
    return txt + pr

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=os.environ.get("RAIDPOINT_APPID", "dev.raidpoint.App"))
        self.terms, self.rows, self.cur = {}, {}, None
        self.cfg = core.load_config()
        self.rebuild_binds()
        try: self.zoom = float(load().get("_zoom", 1.0))
        except Exception: self.zoom = 1.0
        self._spawn_t = {}; self._respawn = set(); self._cloning = set(); self._av_css = set()

    def do_activate(self):
        if getattr(self, "win", None):          # app já aberto: só traz a janela (não duplica janela e temporizadores)
            self.win.present(); return
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        css = Gtk.CssProvider(); css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.ApplicationWindow(application=self, default_width=1150, default_height=720)

        # --- barra de título: toggle da sidebar | projeto | ações
        hb = Gtk.HeaderBar()
        self.titulo = Gtk.Label(label="/dev/raid"); self.titulo.add_css_class("title")
        self.sub = Gtk.Label(label=""); self.sub.add_css_class("subtitle-git")
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        tb.append(self.titulo); tb.append(self.sub)
        hb.set_title_widget(tb)
        self._busy = False; self._sig = None; self._asking = False; self.pr_cache = {}
        self._buf = {}; self._clip_busy = False; self._clip_last_t = 0
        self.attn = {}; self.ci = {}; self.badges = {}; self._ev_ts = time.time(); self._plan_alerted = set()
        tog = Gtk.Button(icon_name="sidebar-show-symbolic", tooltip_text="Mostrar/ocultar projetos (Ctrl+B)")
        tog.connect("clicked", lambda *_: self.toggle_side())
        hb.pack_start(tog)
        mb = Gtk.Button(label="＋ Agente", tooltip_text="Abrir um agente em novo painel (Ctrl+D)")
        mb.connect("clicked", lambda *_: self.palette("Agente"))
        mb.add_css_class("agente")
        hb.pack_start(mb)
        self.usage_lbl = Gtk.Label(use_markup=True, xalign=0, margin_top=10, margin_bottom=10, margin_start=14, margin_end=14,
                                   label="calculando…")
        up = Gtk.Popover(); up.set_child(self.usage_lbl)
        self.usage_btn = Gtk.MenuButton(label="◔ uso", popover=up, tooltip_text="Uso do Claude Code (tokens)")
        hb.pack_start(self.usage_btn)
        def acao(txt, tip, cb, extra=None):
            b = Gtk.Button(icon_name=txt, tooltip_text=tip)
            if extra: b.add_css_class(extra)
            b.connect("clicked", cb); return b
        self.layout = "tiled"
        # só o essencial fica visível; todo o resto está na paleta (Ctrl+D)
        self.sync_on = False
        self.menu_btn = Gtk.Button(icon_name="open-menu-symbolic", tooltip_text="Ações (Ctrl+D)")
        self.menu_btn.connect("clicked", lambda *_: self.palette(""))
        hb.pack_end(self.menu_btn)
        hb.pack_end(acao("emblem-system-symbolic", "Configurações (Ctrl+,)", lambda *_: self.on_settings()))
        hb.pack_end(acao("sidebar-show-right-symbolic", "Painel de agentes (Ctrl+J)", lambda *_: self.toggle_agents()))
        hb.pack_end(acao("document-edit-symbolic", "Mudanças e commit (Ctrl+G)", lambda *_: self.on_changes()))
        self.win.set_titlebar(hb)

        # --- sidebar (largura fixa, não expande)
        self.side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, width_request=190, hexpand=False)
        self.side.add_css_class("side")
        t = Gtk.Label(label="PROJETOS", xalign=0, margin_start=16, margin_top=14, margin_bottom=8)
        t.add_css_class("side-titulo")
        self.list = Gtk.ListBox(); self.list.add_css_class("lista")
        self.list.connect("row-activated", lambda lb, r: self.open(r.name))
        sc = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        sc.set_child(self.list); sc.set_overlay_scrolling(False)
        novo = Gtk.Button(label="＋  Novo projeto"); novo.add_css_class("novo")
        self.addpop = Gtk.Popover(); self.addpop.set_parent(novo)
        ac = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=6, margin_bottom=6,
                     margin_start=6, margin_end=6)
        for nome, cb in [("Pasta local…", self.on_add), ("Servidor SSH / mosh…", self.on_add_remote)]:
            b = Gtk.Button(label=nome, has_frame=False); b.get_child().set_xalign(0); b.add_css_class("pop-item")
            b.connect("clicked", lambda _b, c=cb: (self.addpop.popdown(), c()))
            ac.append(b)
        self.addpop.set_child(ac)
        novo.connect("clicked", lambda *_: self.addpop.popup())
        # abas: Projetos (o que você mexe) | Repos (todos os repositórios git)
        b1 = Gtk.ToggleButton(label="Projetos", active=True, hexpand=True); b1.add_css_class("tab")
        b2 = Gtk.ToggleButton(label="Repos", group=b1, hexpand=True); b2.add_css_class("tab")
        tabs = Gtk.Box(spacing=2); tabs.add_css_class("tabs"); tabs.append(b1); tabs.append(b2)
        self.rlist = Gtk.ListBox(); self.rlist.add_css_class("lista")
        self.rlist.connect("row-activated", lambda lb, r: self.open_repo(r.repo))
        self.rlist.set_filter_func(self.repo_filter)
        self.busca = Gtk.SearchEntry(placeholder_text="Buscar no GitHub…"); self.busca.add_css_class("busca")
        self.busca.connect("search-changed", lambda *_: self.rlist.invalidate_filter())
        self.rcount = Gtk.Label(label="", xalign=0, margin_start=14, margin_bottom=4); self.rcount.add_css_class("ag-sub")
        rsc = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER); rsc.set_child(self.rlist); rsc.set_overlay_scrolling(False)
        rbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        rh = Gtk.Box(); self.rcount.set_hexpand(True)
        rf = Gtk.Button(icon_name="view-refresh-symbolic", has_frame=False, tooltip_text="Atualizar do GitHub", margin_end=8)
        rf.connect("clicked", lambda *_: self.refresh_repos(True)); rh.append(self.rcount); rh.append(rf)
        rbox.append(self.busca); rbox.append(rh); rbox.append(rsc)
        self.sstack = Gtk.Stack(vexpand=True); self.sstack.add_named(sc, "proj"); self.sstack.add_named(rbox, "repo")
        def tab(btn, nome):
            def f(b):
                if b.get_active():
                    self.sstack.set_visible_child_name(nome)
                    if nome == "repo": self.refresh_repos()
            btn.connect("toggled", f)
        tab(b1, "proj"); tab(b2, "repo")
        self.tab_proj = b1; self.repos = []; self._repos_ts = 0
        if os.environ.get("RAIDPOINT_TAB") == "repos": b2.set_active(True)
        self.side.append(tabs); self.side.append(self.sstack); self.side.append(novo)

        # --- terminais
        self.stack = Gtk.Stack(hexpand=True, vexpand=True)
        vazio = Gtk.Label(label="Adicione um projeto para começar"); vazio.add_css_class("vazio-t")
        self.stack.add_named(vazio, "_vazio")

        self.alist = Gtk.ListBox(); self.alist.add_css_class("lista")
        self.alist.set_selection_mode(Gtk.SelectionMode.NONE)
        self.alist.connect("row-activated", lambda lb, r: getattr(r, "act", None) and r.act())
        asc = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER, width_request=280)
        asc.set_child(self.alist); asc.set_overlay_scrolling(False); asc.add_css_class("side-right"); self.asc = asc
        self.rev = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_LEFT, reveal_child=False)
        self.rev.set_child(asc)
        self.adj = Gtk.Adjustment(value=0, lower=0, upper=1, step_increment=1, page_increment=1, page_size=1)
        self.vs = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL, adjustment=self.adj)
        self.vs.add_css_class("rp-scroll")
        self._sync = False; self._scroll_pending = None; self._scroll_busy = False; self._user_ts = 0
        self.adj.connect("value-changed", self.on_scroll_user)
        area = Gtk.Box(hexpand=True); area.append(self.stack); area.append(self.vs)
        root = Gtk.Box(); root.append(self.side); root.append(area); root.append(self.rev)
        self.win.set_child(root)

        a = Gio.SimpleAction.new("side", None); a.connect("activate", lambda *_: self.toggle_side())
        self.add_action(a)
        a2 = Gio.SimpleAction.new("agents", None); a2.connect("activate", lambda *_: self.toggle_agents())
        self.add_action(a2)
        a4 = Gio.SimpleAction.new("palette", None); a4.connect("activate", lambda *_: self.palette(""))
        self.add_action(a4)
        a5 = Gio.SimpleAction.new("settings", None); a5.connect("activate", lambda *_: self.on_settings())
        self.add_action(a5)
        a3 = Gio.SimpleAction.new("changes", None); a3.connect("activate", lambda *_: self.on_changes())
        self.add_action(a3); self.apply_accels()
        mostrar = os.environ.get("RAIDPOINT_SHOW")      # só para desenvolvimento/capturas: changes | palette | settings
        if mostrar:
            fn = {"changes": self.on_changes, "settings": self.on_settings,
                  "palette": lambda: self.palette(os.environ.get("RAIDPOINT_PALETTE_Q", ""))}.get(mostrar)
            if fn: GLib.timeout_add(1500, lambda: (fn(), False)[1])
        if os.environ.get("RAIDPOINT_AGENTS"): self.rev.set_reveal_child(True)
        GLib.timeout_add_seconds(2, self.agents_tick)
        GLib.timeout_add(400, self.scroll_tick)
        GLib.timeout_add_seconds(2, self.ev_tick)
        GLib.timeout_add(600, self.clip_tick)
        GLib.timeout_add_seconds(120, self.ci_tick); GLib.timeout_add_seconds(4, lambda: (self.ci_tick(), False)[1])
        ao = Gio.SimpleAction.new("open-project", GLib.VariantType.new("s"))
        ao.connect("activate", lambda a_, v: (self.win.present(), self.open(v.get_string())))
        self.add_action(ao)
        GLib.timeout_add_seconds(60, self.usage_tick); GLib.timeout_add_seconds(2, lambda: (self.usage_tick(), False)[1])
        GLib.timeout_add_seconds(1, self.req_tick)
        GLib.timeout_add_seconds(10, self.git_tick); GLib.timeout_add_seconds(1, lambda: (self.git_tick(), False)[1])

        self.refresh_list()
        GLib.timeout_add_seconds(3, self.tick)
        self.win.present()
        self.refresh_repos()
        db = load(); ns = self.names()
        alvo = os.environ.get("RAIDPOINT_OPEN")
        self.open(alvo if alvo in ns else (db.get("_last") if db.get("_last") in ns else (ns[0] if ns else None)))

    def toggle_side(self):
        self.side.set_visible(not self.side.get_visible())

    def rebuild_binds(self):
        self.binds = {}
        for act in ("zoom_in", "zoom_out", "zoom_reset", "copy", "paste"):
            acc = self.cfg.get("keys", {}).get(act, "")
            ok, kv, md = Gtk.accelerator_parse(acc) if acc else (False, 0, 0)
            if ok: self.binds[(Gdk.keyval_to_lower(kv), int(md))] = act

    def apply_accels(self):
        k = self.cfg.get("keys", {})
        for act, nome in (("palette", "palette"), ("settings", "settings"), ("changes", "changes"),
                          ("agents_panel", "agents"), ("sidebar", "side")):
            acc = k.get(act, "")
            self.set_accels_for_action(f"app.{nome}", [acc] if acc else [])

    def apply_theme(self, term):
        bg, fg, pal = core.THEMES.get(self.cfg["terminal"].get("theme"), core.THEMES["Catppuccin Mocha"])
        f, b = Gdk.RGBA(), Gdk.RGBA(); f.parse(fg); b.parse(bg)
        cores = []
        for h in pal.split():
            c = Gdk.RGBA(); c.parse(h); cores.append(c)
        term.set_colors(f, b, cores)

    def names(self):
        return [n for n, v in load().items() if isinstance(v, dict) and not n.startswith("_")]

    def avatar(self, nome):
        """quadradinho colorido com a inicial (o provider de CSS de cada cor é criado uma única vez)"""
        av = Gtk.Label(label=nome[0].upper(), halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        av.add_css_class("avatar")
        cls = "av" + hashlib.md5(nome.encode()).hexdigest()[:8]
        if cls not in self._av_css:
            self._av_css.add(cls)
            p = Gtk.CssProvider(); p.load_from_string(f".{cls} {{ background: {cor(nome)}; }}")
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        av.add_css_class(cls)
        return av

    def refresh_list(self):
        while (r := self.list.get_first_child()): self.list.remove(r)
        self.rows = {}; self.badges = {}; on = alive(); db = load()
        for n in self.names():
            row = Gtk.ListBoxRow(); row.name = n
            box = Gtk.Box(spacing=10)
            av = self.avatar(n)
            nome = Gtk.Label(label=n, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
            nome.add_css_class("nome")
            dot = Gtk.Label(label="●")
            dot.add_css_class("ponto-remoto" if db[n].get("host") else ("ponto-on" if core.sess(n) in on else "ponto-off"))
            badge = Gtk.Label(label=""); self.badges[n] = badge
            box.append(av); box.append(nome); box.append(badge); box.append(dot)
            row.set_child(box); self.list.append(row); self.rows[n] = (row, dot)
            if n == self.cur: self.list.select_row(row)
        self.update_badges()

    def tick(self):
        on = alive(); db = load()
        for n, (_, dot) in self.rows.items():
            if db.get(n, {}).get("host"): continue
            dot.remove_css_class("ponto-on"); dot.remove_css_class("ponto-off")
            dot.add_css_class("ponto-on" if core.sess(n) in on else "ponto-off")
        return True

    def open(self, name):
        p = load().get(name) if name else None
        if not p:
            self.titulo.set_label("/dev/raid"); return
        if name not in self.terms:
            term = Vte.Terminal(hexpand=True, vexpand=True)
            term.set_scrollback_lines(0)
            term.set_font(Pango.FontDescription(self.cfg['terminal']['font'])); term.set_font_scale(self.zoom)
            self.apply_theme(term)
            term.set_cursor_blink_mode(Vte.CursorBlinkMode.OFF)
            self.setup_term_extras(term, name)
            kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            kc.connect("key-pressed", lambda c, kv, kcode, st, n=name: self.on_term_key(n, kv, st))
            term.add_controller(kc)
            sc = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
            sc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            def zscroll(c, dx, dy):
                if not (c.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK): return False
                self.set_zoom(self.zoom - float(self.cfg['terminal'].get('zoom_step', 0.1)) * (1 if dy > 0 else -1)); return True
            sc.connect("scroll", zscroll); term.add_controller(sc)
            term.connect("child-exited", lambda t, s, n=name: self.on_child_exit(n))
            self.terms[name] = term; self.stack.add_named(term, name); self.spawn(name)
        self.cur = name
        self.attn.pop(name, None); self.update_badges()
        self.stack.set_visible_child_name(name)
        self.terms[name].grab_focus()
        setp(lambda d: d.__setitem__("_last", name))
        self.set_sync_ui(name, False); self.refresh_sync(name)
        where = f"{p['host']}:{p.get('dir') or '~'}" if p.get("host") else p["dir"].replace(os.path.expanduser("~"), "~")
        self.titulo.set_label(f"{name}  —  {where}")
        if name in self.rows: self.list.select_row(self.rows[name][0])

    def spawn(self, name):
        p = load().get(name)
        if not p or name not in self.terms: return
        env = [f"{k}={v}" for k, v in os.environ.items() if k != "TMUX"]
        env += ["TERM=xterm-256color", "COLORTERM=truecolor"]
        if p.get("host"):
            argv, cwd = core.remote_argv(name, p), os.path.expanduser("~")
        else:
            d = os.path.expanduser(p["dir"])
            argv, cwd = TMUX + ["new-session", "-A", "-s", core.sess(name), "-c", d], (d if os.path.isdir(d) else os.path.expanduser("~"))
        self._spawn_t[name] = time.time()
        self.terms[name].spawn_async(Vte.PtyFlags.DEFAULT, cwd, argv, env,
            GLib.SpawnFlags.SEARCH_PATH, None, None, -1, None, None)

    def on_child_exit(self, name):
        """o cliente tmux/ssh/mosh terminou: reabre. Se caiu logo ao abrir, espera 5s (sem laço de reinício)"""
        if name not in self.terms or name in self._respawn: return
        if time.time() - self._spawn_t.get(name, 0) >= 4:
            self.spawn(name); return
        self._respawn.add(name)
        self.terms[name].feed("\r\n\x1b[33m[/dev/raid] a conexão caiu logo ao abrir; tentando de novo em 5s…\x1b[0m\r\n".encode())
        def again():
            self._respawn.discard(name); self.spawn(name); return False
        GLib.timeout_add_seconds(5, again)

    def t(self, *cmd):
        if not self.cur: return
        proj = self.cur; d = pdir(proj)
        extra = ["-c", d] if d and cmd[0] in ("split-window", "new-window") else []
        alvo = core.tgt(proj)
        threading.Thread(target=lambda: run_tmux(proj, cmd[0], "-t", alvo, *cmd[1:], *extra), daemon=True).start()
        self.terms[proj].grab_focus()

    def set_layout(self, lay):
        self.layout = lay
        if self.cur:
            proj = self.cur
            threading.Thread(target=lambda: run_tmux(proj, "select-layout", "-t", core.tgt(proj), lay), daemon=True).start()
            self.terms[proj].grab_focus()

    def add_pane(self, title, cmd, worktree=False):
        if not self.cur: return
        proj = self.cur
        def work():
            pid, d, err = core.spawn_pane(proj, title, cmd, worktree, self.layout)
            GLib.idle_add(self.after_pane, proj, err)
        threading.Thread(target=work, daemon=True).start()

    def after_pane(self, proj, err):
        if err: Gtk.AlertDialog(message="Não consegui abrir o painel", detail=err).show(self.win)
        elif proj in self.terms: self.terms[proj].grab_focus()
        return False

    def add_agent(self, ag, worktree=False):
        self.add_pane(ag["name"], ag["cmd"], worktree)

    def toggle_sync(self):
        if not self.cur: return
        proj = self.cur
        def work():
            r = run_tmux(proj, "show-options", "-wv", "-t", core.tgt(proj), "synchronize-panes").stdout.strip()
            novo = "off" if r == "on" else "on"
            run_tmux(proj, "set-option", "-w", "-t", core.tgt(proj), "synchronize-panes", novo)
            GLib.idle_add(self.set_sync_ui, proj, novo == "on")
        threading.Thread(target=work, daemon=True).start()
        self.terms[proj].grab_focus()

    def set_sync_ui(self, proj, on):
        if proj == self.cur:
            self.sync_on = on
            (self.menu_btn.add_css_class if on else self.menu_btn.remove_css_class)("sync-on")
        return False

    def refresh_sync(self, proj):
        def work():
            r = run_tmux(proj, "show-options", "-wv", "-t", core.tgt(proj), "synchronize-panes").stdout.strip()
            GLib.idle_add(self.set_sync_ui, proj, r == "on")
        threading.Thread(target=work, daemon=True).start()

    # ---------- copiar e colar
    def set_clipboard(self, txt):
        d = Gdk.Display.get_default()
        d.get_clipboard().set(txt)
        try: d.get_primary_clipboard().set(txt)
        except Exception: pass

    def on_term_key(self, name, keyval, state):
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK); shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        term = self.terms.get(name)
        if not term: return False
        mods = int(state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
                            | Gdk.ModifierType.ALT_MASK | Gdk.ModifierType.SUPER_MASK))
        kv = Gdk.keyval_to_lower(keyval)
        act = self.binds.get((kv, mods)) or self.binds.get((kv, mods & ~int(Gdk.ModifierType.SHIFT_MASK)))
        if not act and kv in (Gdk.KEY_equal, Gdk.KEY_KP_Add):      # "+" sem Shift (=) também aumenta
            act = self.binds.get((Gdk.KEY_plus, mods & ~int(Gdk.ModifierType.SHIFT_MASK)))
        step = float(self.cfg["terminal"].get("zoom_step", 0.1))
        if act == "zoom_in": self.set_zoom(self.zoom + step); return True
        if act == "zoom_out": self.set_zoom(self.zoom - step); return True
        if act == "zoom_reset": self.set_zoom(1.0); return True
        if act == "copy": self.do_copy(name); return True
        if act == "paste": term.paste_clipboard(); return True
        if (ctrl and not shift and keyval == Gdk.KEY_Insert): self.do_copy(name); return True
        if shift and not ctrl and keyval == Gdk.KEY_Insert: term.paste_clipboard(); return True
        return False

    def set_zoom(self, z):
        self.zoom = round(max(0.5, min(3.0, z)), 2)
        for t in self.terms.values(): t.set_font_scale(self.zoom)
        setp(lambda d: d.__setitem__("_zoom", self.zoom))

    def do_copy(self, name):
        term = self.terms.get(name)
        if not term: return
        if term.get_has_selection():           # seleção nativa (Shift+arrastar)
            term.copy_clipboard_format(Vte.Format.TEXT)
        else:                                  # senão: o último texto copiado dentro do tmux
            def work():
                r = core.run_tmux(name, "show-buffer", timeout=5)
                if r.returncode == 0 and r.stdout: GLib.idle_add(self.set_clipboard, r.stdout)
            threading.Thread(target=work, daemon=True).start()

    # ---------- links e menu de botão direito
    def setup_term_extras(self, term, name):
        term.set_allow_hyperlink(True)
        try:
            tag = term.match_add_regex(Vte.Regex.new_for_match(URL_RE, -1, 0x400), 0)  # 0x400 = PCRE2_MULTILINE
            term.match_set_cursor_name(tag, "pointer")
        except Exception as e:
            print("aviso: detecção de links indisponível:", e, file=sys.stderr)
        # Ctrl+clique abre o link (captura antes do tmux/aplicativo)
        gl = Gtk.GestureClick(button=1); gl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def left(g, n, x, y):
            if not (g.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK): return
            u = self.link_at(term, x, y)
            if u:
                g.set_state(Gtk.EventSequenceState.CLAIMED); self.open_uri(u)
        gl.connect("pressed", left); term.add_controller(gl)
        # botão direito: menu próprio (funciona mesmo dentro de tmux/TUIs que capturam o mouse)
        gr = Gtk.GestureClick(button=3); gr.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def right(g, n, x, y):
            g.set_state(Gtk.EventSequenceState.CLAIMED); self.show_ctx(name, term, x, y)
        gr.connect("pressed", right); term.add_controller(gr)

    def link_at(self, term, x, y):
        try:
            u = term.check_hyperlink_at(x, y)
            if u: return u
            m = term.check_match_at(x, y)
            m = m[0] if isinstance(m, (tuple, list)) else m
            if m: return m if re.match(r"[a-z]+://", m) else "https://" + m
        except Exception:
            pass
        return None

    # ---------- paleta de comandos (Ctrl+D): tudo do app, por teclado
    def commands(self):
        step = float(self.cfg["terminal"].get("zoom_step", 0.1))
        C = []
        def add(label, hint, fn): C.append((label, hint, fn))
        for ag in agentes():
            add(f"Agente: {ag['name']}", "novo painel", lambda ag=ag: self.add_agent(ag))
            if ag.get("cmd"):
                add(f"Agente: {ag['name']} em worktree isolada", "branch própria", lambda ag=ag: self.add_agent(ag, True))
        add("Painel: novo shell", "usa o layout", lambda: self.add_pane("Shell", ""))
        add("Painel: nova aba", "", lambda: self.t("new-window"))
        add("Painel: zoom", "Alt+z", lambda: self.t("resize-pane", "-Z"))
        add("Painel: fechar", "Alt+w", lambda: self.t("kill-pane"))
        add("Painéis: digitar em todos " + ("(ligado ✓)" if self.sync_on else ""), "", self.toggle_sync)
        for nome, lay in [("colunas (lado a lado)", "even-horizontal"), ("linhas (empilhados)", "even-vertical"),
                          ("grade", "tiled"), ("principal à esquerda", "main-vertical"), ("principal em cima", "main-horizontal")]:
            add(f"Layout: {nome}", "", lambda l=lay: self.set_layout(l))
        add("Mudanças: ver diff e commitar", "Ctrl+G", self.on_changes)
        add("Painel de agentes: mostrar/ocultar", "Ctrl+J", self.toggle_agents)
        add("Lista de projetos: mostrar/ocultar", "Ctrl+B", self.toggle_side)
        add("Segredos do projeto…", "", self.on_secrets)
        add("Projeto: remover…", "", self.on_remove)
        add("Texto: aumentar", "Ctrl +", lambda: self.set_zoom(self.zoom + step))
        add("Texto: diminuir", "Ctrl −", lambda: self.set_zoom(self.zoom - step))
        add("Texto: tamanho normal", "Ctrl 0", lambda: self.set_zoom(1.0))
        add("Configurações", "Ctrl+,", self.on_settings)
        add("Configurações: abrir config.toml (avançado)", "", self.open_config)
        for n in self.names():
            add(f"Projeto: {n}", "abrir", lambda n=n: self.open(n))
        return C

    def palette(self, inicial=""):
        import unicodedata
        norm = lambda t: "".join(c for c in unicodedata.normalize("NFD", t.lower()) if not unicodedata.combining(c))
        w = Gtk.Window(title="Comandos", transient_for=self.win, modal=True, default_width=560, default_height=420, resizable=False)
        entry = Gtk.SearchEntry(placeholder_text="Digite um comando… (↑ ↓ Enter, Esc fecha)", margin_top=10, margin_start=10, margin_end=10)
        lst = Gtk.ListBox(); lst.add_css_class("lista")
        sc = Gtk.ScrolledWindow(vexpand=True, margin_top=8, margin_bottom=10, margin_start=10, margin_end=10,
                                hscrollbar_policy=Gtk.PolicyType.NEVER)
        sc.set_child(lst)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.append(entry); box.append(sc); w.set_child(box)
        cmds = self.commands()

        def fill(*_):
            q = norm(entry.get_text()).split()
            while (r := lst.get_first_child()): lst.remove(r)
            for label, hint, fn in cmds:
                if all(t in norm(label) for t in q):
                    r = Gtk.ListBoxRow(); r.fn = fn
                    h = Gtk.Box(spacing=8, margin_top=3, margin_bottom=3, margin_start=6, margin_end=6)
                    h.append(Gtk.Label(label=label, xalign=0, hexpand=True))
                    if hint:
                        l = Gtk.Label(label=hint); l.add_css_class("ag-sub"); h.append(l)
                    r.set_child(h); lst.append(r)
            first = lst.get_row_at_index(0)
            if first: lst.select_row(first)

        def run(row=None):
            row = row or lst.get_selected_row()
            if not row: return
            w.close()
            GLib.idle_add(lambda: (row.fn(), False)[1])

        def move(d):
            row = lst.get_selected_row(); i = (row.get_index() if row else -1) + d
            nxt = lst.get_row_at_index(max(0, i))
            if nxt: lst.select_row(nxt); nxt.grab_focus(); entry.grab_focus()

        entry.connect("search-changed", fill); entry.connect("activate", lambda *_: run())
        lst.connect("row-activated", lambda l, r: run(r))
        kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def key(c, kv, kcode, st):
            if kv == Gdk.KEY_Escape: w.close(); return True
            if kv == Gdk.KEY_Down: move(1); return True
            if kv == Gdk.KEY_Up: move(-1); return True
            return False
        kc.connect("key-pressed", key); w.add_controller(kc)
        w.connect("close-request", lambda *_: (self.terms.get(self.cur) and GLib.idle_add(lambda: (self.terms[self.cur].grab_focus(), False)[1]), False)[1])
        entry.set_text(inicial); fill(); w.present(); entry.grab_focus(); entry.set_position(-1)

    # ---------- Configurações (visual, estilo VS Code); salva sozinho a cada mudança
    def on_settings(self, *_):
        for x in Gtk.Window.list_toplevels():
            if x.get_title() == "Configurações": x.present(); return
        w = Gtk.Window(title="Configurações", transient_for=self.win, default_width=900, default_height=600)
        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True, vexpand=True)
        side = Gtk.StackSidebar(stack=stack, width_request=190)
        root = Gtk.Box(); root.append(side); root.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)); root.append(stack)
        w.set_child(root)

        def page(nome, titulo, sub=""):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=22, margin_bottom=22, margin_start=28, margin_end=28)
            t = Gtk.Label(label=titulo, xalign=0); t.add_css_class("title-1"); box.append(t)
            if sub:
                l = Gtk.Label(label=sub, xalign=0, wrap=True); l.add_css_class("ag-sub"); box.append(l)
            sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER); sc.set_child(box)
            stack.add_titled(sc, nome, titulo); return box

        def linha(box, rotulo, dica, widget):
            h = Gtk.Box(spacing=12)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
            a = Gtk.Label(label=rotulo, xalign=0); v.append(a)
            if dica:
                d = Gtk.Label(label=dica, xalign=0, wrap=True); d.add_css_class("ag-sub"); v.append(d)
            h.append(v); widget.set_valign(Gtk.Align.CENTER); h.append(widget); box.append(h)

        def salvar(): core.save_config(self.cfg)

        # --- Terminal
        t = page("terminal", "Terminal", "Aparência do texto nos painéis. Vale na hora.")
        fd = Gtk.FontDialogButton(dialog=Gtk.FontDialog(modal=True))
        fd.set_font_desc(Pango.FontDescription(self.cfg["terminal"]["font"]))
        def font_mudou(*_):
            d = fd.get_font_desc()
            if not d: return
            self.cfg["terminal"]["font"] = d.to_string(); salvar()
            for tm in self.terms.values(): tm.set_font(Pango.FontDescription(self.cfg["terminal"]["font"]))
        fd.connect("notify::font-desc", font_mudou)
        linha(t, "Fonte", "Use uma fonte monoespaçada.", fd)
        sp = Gtk.SpinButton.new_with_range(50, 300, 5); sp.set_value(round(self.zoom * 100))
        sp.connect("value-changed", lambda b: self.set_zoom(b.get_value() / 100))
        linha(t, "Tamanho (zoom %)", "Também: Ctrl + / Ctrl − / Ctrl 0 / Ctrl+roda.", sp)
        st = Gtk.SpinButton.new_with_range(1, 50, 1); st.set_value(round(float(self.cfg["terminal"].get("zoom_step", 0.1)) * 100))
        def step_mudou(b):
            self.cfg["terminal"]["zoom_step"] = round(b.get_value() / 100, 2); salvar()
        st.connect("value-changed", step_mudou)
        linha(t, "Passo do zoom (%)", "Quanto cada Ctrl + / Ctrl − muda.", st)
        nomes = list(core.THEMES)
        dd = Gtk.DropDown.new_from_strings(nomes)
        atual = self.cfg["terminal"].get("theme")
        dd.set_selected(nomes.index(atual) if atual in nomes else 0)
        def tema_mudou(*_):
            self.cfg["terminal"]["theme"] = nomes[dd.get_selected()]; salvar()
            for tm in self.terms.values(): self.apply_theme(tm)
        dd.connect("notify::selected", tema_mudou)
        linha(t, "Tema de cores", "Cores do terminal.", dd)

        # --- Atalhos
        k = page("atalhos", "Atalhos", "Clique no atalho e aperte a nova combinação. Backspace remove, Esc cancela.")
        ROT = [("palette", "Abrir ações (paleta de comandos)"), ("settings", "Abrir configurações"),
               ("changes", "Mudanças / diff / commit"), ("agents_panel", "Painel de agentes"),
               ("sidebar", "Lista de projetos"), ("zoom_in", "Aumentar texto"), ("zoom_out", "Diminuir texto"),
               ("zoom_reset", "Texto normal"), ("copy", "Copiar"), ("paste", "Colar")]
        capturando = {"k": None}
        botoes = {}
        def legivel(acc):
            if not acc: return "—"
            ok, kv, md = Gtk.accelerator_parse(acc)
            return Gtk.accelerator_get_label(kv, md) if ok else acc
        def aplicar():
            salvar(); self.rebuild_binds(); self.apply_accels()
        for chave, rot in ROT:
            b = Gtk.Button(label=legivel(self.cfg["keys"].get(chave, "")), width_request=190)
            botoes[chave] = b
            def clicou(_b, chave=chave):
                if capturando["k"]: botoes[capturando["k"]].set_label(legivel(self.cfg["keys"].get(capturando["k"], "")))
                capturando["k"] = chave; botoes[chave].set_label("pressione a combinação…")
            b.connect("clicked", clicou); linha(k, rot, "", b)
        kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def tecla(c, kv, kcode, stt):
            ch = capturando["k"]
            if not ch: return False
            if kv in (Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R, Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
                      Gdk.KEY_Super_L, Gdk.KEY_Super_R, Gdk.KEY_Meta_L, Gdk.KEY_Meta_R): return True
            if kv == Gdk.KEY_Escape: pass
            elif kv == Gdk.KEY_BackSpace: self.cfg["keys"][ch] = ""; aplicar()
            else:
                md = stt & Gtk.accelerator_get_default_mod_mask()
                acc = Gtk.accelerator_name(Gdk.keyval_to_lower(kv), md)
                dono = [o for o, v in self.cfg["keys"].items() if v == acc and o != ch]
                if dono: botoes[ch].set_label("já usado em: " + dono[0]); capturando["k"] = None; return True
                self.cfg["keys"][ch] = acc; aplicar()
            botoes[ch].set_label(legivel(self.cfg["keys"].get(ch, ""))); capturando["k"] = None
            return True
        kc.connect("key-pressed", tecla); w.add_controller(kc)
        sep = Gtk.Label(label="Fixos no tmux (movem e dividem painéis, funcionam dentro de qualquer projeto)", xalign=0, margin_top=14)
        sep.add_css_class("ag-sec"); k.append(sep)
        for a_, b_ in [("Alt + setas", "foco entre painéis"), ("Alt+Shift + setas", "trocar painel de lugar"),
                       ("Alt+\\  /  Alt+-", "dividir lado a lado / embaixo"), ("Alt+t", "nova aba"),
                       ("Alt+1…9", "ir para a aba N"), ("Alt+z", "zoom no painel"), ("Alt+w", "fechar painel (pergunta antes)"),
                       ("Ctrl+PageUp/PageDown", "aba anterior / próxima")]:
            h = Gtk.Box(spacing=12); l1 = Gtk.Label(label=a_, xalign=0, width_request=190); l1.add_css_class("ag-row")
            l2 = Gtk.Label(label=b_, xalign=0); l2.add_css_class("ag-sub"); h.append(l1); h.append(l2); k.append(h)

        # --- Agentes
        g = page("agentes", "Agentes", "Os programas que aparecem em ＋ Agente e na paleta. Comando vazio = só um shell.")
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); g.append(caixa)
        estado = [dict(a) for a in agentes()]
        def grava():
            core.save_agents(estado)
        def monta():
            while (r := caixa.get_first_child()): caixa.remove(r)
            for i, a in enumerate(estado):
                h = Gtk.Box(spacing=8)
                n = Gtk.Entry(text=a["name"], placeholder_text="nome", width_chars=14)
                c = Gtk.Entry(text=a.get("cmd", ""), placeholder_text="comando (ex.: claude)", hexpand=True)
                n.connect("changed", lambda e, a=a: (a.__setitem__("name", e.get_text()), grava()))
                c.connect("changed", lambda e, a=a: (a.__setitem__("cmd", e.get_text()), grava()))
                rm = Gtk.Button(icon_name="edit-delete-symbolic", has_frame=False)
                rm.connect("clicked", lambda _b, i=i: (estado.pop(i), grava(), monta()))
                h.append(n); h.append(c); h.append(rm); caixa.append(h)
        monta()
        novo = Gtk.Button(label="＋ Adicionar agente", halign=Gtk.Align.START)
        novo.connect("clicked", lambda *_: (estado.append({"name": "Novo", "cmd": ""}), grava(), monta()))
        g.append(novo)

        # --- Avançado
        v = page("avancado", "Avançado", "Onde ficam os arquivos do app.")
        for rot, caminho in [("Configuração", core.HOME / "config.toml"), ("Agentes", core.CFG / "agents.json"),
                             ("Dados (memória, eventos)", core.DATA), ("Workspaces do GitHub", core.WS)]:
            h = Gtk.Box(spacing=12); l1 = Gtk.Label(label=rot, xalign=0, width_request=190)
            l2 = Gtk.Label(label=str(caminho), xalign=0, selectable=True, hexpand=True); l2.add_css_class("ag-sub")
            bt = Gtk.Button(label="Abrir"); bt.connect("clicked", lambda _b, c=caminho: self.open_uri(str(c)))
            h.append(l1); h.append(l2); h.append(bt); v.append(h)
        kc2 = Gtk.EventControllerKey()
        kc2.connect("key-pressed", lambda c, kv, kcode, stt: (w.close(), True)[1] if kv == Gdk.KEY_Escape and not capturando["k"] else False)
        w.add_controller(kc2)
        w.present()

    def open_config(self):
        core.load_config()                                   # garante que o arquivo existe
        self.open_uri(str(core.HOME / "config.toml"))

    def open_uri(self, uri):
        try: subprocess.Popen(["xdg-open", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception: pass

    def pane_at(self, name, term, x, y):
        """id do painel do tmux que está sob o ponteiro (None se não achar)"""
        cw, ch = term.get_char_width(), term.get_char_height()
        if cw <= 0 or ch <= 0: return None
        col, row = int((x - 12) // cw), int((y - 10) // ch)      # 12/10 = padding do CSS do terminal
        info = core.run_tmux(name, "display-message", "-p", "-t", core.tgt(name), "#{status}|#{status-position}", timeout=5).stdout.strip().split("|")
        if len(info) == 2 and info[0] not in ("off", "0") and info[1] == "top": row -= 1   # linha das abas
        r = core.run_tmux(name, "list-panes", "-t", core.tgt(name), "-F",
                          "#{pane_id} #{pane_left} #{pane_top} #{pane_right} #{pane_bottom}", timeout=5)
        for l in r.stdout.splitlines():
            try: pid, l_, t_, r_, b_ = l.split(); l_, t_, r_, b_ = int(l_), int(t_), int(r_), int(b_)
            except ValueError: continue
            if l_ <= col <= r_ and t_ - 1 <= row <= b_:          # t_-1: a borda com o título fica acima
                return pid
        return None

    def pane_action(self, name, fut, *cmd, cwd=False):
        """roda um comando do tmux no painel sob o mouse (espera o cálculo terminar; cai no painel ativo)"""
        def work():
            fut["th"].join(6)
            painel = fut.get("pane") or core.tgt(name)
            extra = ["-c", pdir(name)] if cwd and pdir(name) else []
            if cmd[0] == "break-pane":          # no break-pane, -s é o painel de origem (-t seria o destino)
                core.run_tmux(name, "break-pane", "-s", painel, *cmd[1:])
            elif cmd[0] == "new-window":        # nova aba é da SESSÃO (um id de painel como alvo daria 'index in use')
                core.run_tmux(name, "new-window", "-t", core.tgt(name), *cmd[1:], *extra)
            else:
                core.run_tmux(name, cmd[0], "-t", painel, *cmd[1:], *extra)
        threading.Thread(target=work, daemon=True).start()

    def confirm_kill(self, name, fut):
        dlg = Gtk.AlertDialog(message="Fechar este painel?", detail="O processo que está rodando nele será encerrado.",
                              buttons=["Cancelar", "Fechar painel"], cancel_button=0, default_button=0)
        def done(d, res):
            try:
                if d.choose_finish(res) == 1: self.pane_action(name, fut, "kill-pane")
            except GLib.Error: pass
        dlg.choose(self.win, None, done)

    def show_ctx(self, name, term, x, y):
        link = self.link_at(term, x, y)
        fut = {"pane": None}
        def calc():
            try: fut["pane"] = self.pane_at(name, term, x, y)
            except Exception: pass
        fut["th"] = threading.Thread(target=calc, daemon=True); fut["th"].start()
        pop = Gtk.Popover(has_arrow=False); pop.set_parent(term)
        r = Gdk.Rectangle(); r.x, r.y, r.width, r.height = int(x), int(y), 1, 1; pop.set_pointing_to(r)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=4, margin_bottom=4, margin_start=4, margin_end=4)
        def item(txt, cb, css=None):
            b = Gtk.Button(label=txt, has_frame=False); b.get_child().set_xalign(0); b.add_css_class("pop-item")
            if css: b.add_css_class(css)
            b.connect("clicked", lambda *_: (pop.popdown(), cb())); box.append(b)
        def sep(): box.append(Gtk.Separator())
        if link:
            item("Abrir link", lambda: self.open_uri(link)); item("Copiar link", lambda: self.set_clipboard(link)); sep()
        item("Copiar", lambda: self.do_copy(name))
        item("Colar", lambda: term.paste_clipboard())
        sep()
        item("Dividir à direita  (lado a lado)", lambda: self.pane_action(name, fut, "split-window", "-h", cwd=True))
        item("Dividir embaixo", lambda: self.pane_action(name, fut, "split-window", "-v", cwd=True))
        item("Zoom neste painel", lambda: self.pane_action(name, fut, "resize-pane", "-Z"))
        item("Mover para nova aba", lambda: self.pane_action(name, fut, "break-pane"))
        item("Nova aba", lambda: self.pane_action(name, fut, "new-window", cwd=True))
        sep()
        item("Fechar painel…", lambda: self.confirm_kill(name, fut), "perigo")
        pop.set_child(box)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def clip_tick(self):
        """tudo que for copiado dentro do tmux (mouse ou modo de cópia) vai para a área de transferência do sistema"""
        if not self.cur or self._clip_busy: return True
        proj = self.cur
        if load().get(proj, {}).get("host") and time.time() - self._clip_last_t < 2: return True
        self._clip_busy = True; self._clip_last_t = time.time()
        def work():
            try:
                r = core.run_tmux(proj, "show-buffer", timeout=5)
                txt = r.stdout if r.returncode == 0 else ""
            except Exception:
                txt = None
            GLib.idle_add(self.clip_apply, proj, txt)
        threading.Thread(target=work, daemon=True).start()
        return True

    def clip_apply(self, proj, txt):
        self._clip_busy = False
        if txt is None: return False
        prev = self._buf.get(proj); self._buf[proj] = txt
        if prev is not None and txt != prev and txt.strip():
            self.set_clipboard(txt)
        return False

    # ---------- avisos: agente terminou / precisa de você
    def notify(self, proj, titulo, corpo):
        n = Gio.Notification.new(titulo); n.set_body(corpo)
        n.set_default_action_and_target("app.open-project", GLib.Variant.new_string(proj))
        self.send_notification(f"ag-{proj}", n)

    def ev_tick(self):
        evs = [e for e in core.read_events(max_age=120) if e["ts"] > self._ev_ts]
        if not evs: return True
        self._ev_ts = max(e["ts"] for e in evs)
        projs = set(self.names())
        for e in evs:
            p = e.get("project")
            if p not in projs: continue
            ev = e.get("event"); olhando = self.win.is_active() and p == self.cur
            if ev == "UserPromptSubmit": self.attn[p] = "working"
            elif ev == "SessionEnd": self.attn.pop(p, None)
            elif ev == "Stop":
                if olhando: self.attn.pop(p, None)
                else:
                    self.attn[p] = "done"; self.notify(p, f"{p}: terminou", "O agente (Claude Code) terminou de responder.")
            elif ev == "Notification" and not olhando:
                self.attn[p] = "waiting"; self.notify(p, f"{p}: precisa de você", e.get("message") or "O agente está esperando uma resposta.")
        self.update_badges()
        return True

    def update_badges(self):
        for n, b in self.badges.items():
            for c in ("badge-wait", "badge-done", "badge-work", "badge-fail"): b.remove_css_class(c)
            a = self.attn.get(n); ci = self.ci.get(n)
            if a == "waiting": b.set_label("!"); b.add_css_class("badge-wait"); b.set_tooltip_text("o agente precisa de você")
            elif a == "done": b.set_label("✓"); b.add_css_class("badge-done"); b.set_tooltip_text("o agente terminou")
            elif a == "working": b.set_label("…"); b.add_css_class("badge-work"); b.set_tooltip_text("o agente está trabalhando")
            elif ci: b.set_label("✗"); b.add_css_class("badge-fail"); b.set_tooltip_text(ci)
            else: b.set_label(""); b.set_tooltip_text(None)

    def ci_tick(self):
        db = load(); alvos = {n: os.path.expanduser(p["dir"]) for n, p in db.items()
                              if isinstance(p, dict) and p.get("dir") and not p.get("host") and not n.startswith("_")}
        def work():
            res = {}
            for n, d in alvos.items():
                try: g = core.git_detail_cached(d, ttl=100)
                except Exception: g = None
                if g and g["ci"] == "fail" and g["runs"] and time.time() - g["runs"][0]["ts"] < 3 * 86400:
                    res[n] = f"CI falhou: {g['runs'][0]['name']} ({core.ago(g['runs'][0]['ts'])})"
            GLib.idle_add(self.set_ci, res)
        threading.Thread(target=work, daemon=True).start()
        return True

    def set_ci(self, res):
        self.ci = res; self.update_badges(); return False

    # ---------- uso do Claude Code
    def usage_tick(self):
        def work():
            try: S = core.usage_summary()
            except Exception: return
            GLib.idle_add(self.render_usage, S)
        threading.Thread(target=work, daemon=True).start()
        return True

    def render_usage(self, S):
        f = core.fmt_tokens; esc = GLib.markup_escape_text
        pl = core.plan_status(); fh = (pl or {}).get("five_hour")
        if fh and fh.get("used_percentage") is not None and pl["age_s"] < 1800:
            self.usage_btn.set_label(f"◔ 5h {fh['used_percentage']:.0f}%")
        else:
            self.usage_btn.set_label(f"◔ 5h {f(S['5h']['new'])}")
        for nome, k, lim in (("5 horas", "five_hour", 80), ("semana", "seven_day", 85)):
            w = (pl or {}).get(k)
            if w and w.get("used_percentage", 0) >= lim and (k, w.get("resets_at")) not in self._plan_alerted:
                self._plan_alerted.add((k, w.get("resets_at")))
                n = Gio.Notification.new(f"Limite do plano ({nome}): {w['used_percentage']:.0f}%")
                n.set_body("Reseta " + time.strftime("%d/%m %H:%M", time.localtime(w["resets_at"]))); self.send_notification(f"plano-{k}", n)
        L = []
        if pl and (pl.get("five_hour") or pl.get("seven_day")):
            L.append("<b>Plano</b>  <span foreground='#6c7086'>(dado do Claude Code há %d min)</span>" % (pl["age_s"] // 60))
            for nome, k in (("5 horas", "five_hour"), ("semana", "seven_day")):
                w = pl.get(k)
                if w and w.get("used_percentage") is not None:
                    pct = w["used_percentage"]; cor_ = "#f38ba8" if pct >= 85 else ("#f9e2af" if pct >= 60 else "#a6e3a1")
                    rs = time.strftime("%d/%m %H:%M", time.localtime(w["resets_at"])) if w.get("resets_at") else "?"
                    L.append(f"<tt>{nome:<8}</tt><span foreground='{cor_}'><b>{pct:>3.0f}%</b></span>  <span foreground='#6c7086'>reseta {rs}</span>")
            L.append("")
        else:
            L.append("<span foreground='#6c7086'>Plano: sem dados. Ative com: raidpoint install-statusline</span>\n")
        L += ["<b>Claude Code — tokens</b>  <span foreground='#6c7086'>(entrada + saída + cache criado)</span>"]
        for w in ("5h", "24h", "7d"):
            o = S[w]
            L.append(f"<tt>{w:>3}  {f(o['new']):>7}   saída {f(o['out']):>6}   cache lido {f(o['cache_read']):>7}   {o['msgs']} msgs</tt>")
        L.append("\n<b>Por projeto (7d)</b>")
        for p, n in sorted(S["7d"]["by_project"].items(), key=lambda x: -x[1])[:6]:
            L.append(f"<tt>{esc(p)[:22]:<22} {f(n):>7}</tt>")
        L.append("\n<b>Por modelo (7d)</b>")
        for m, n in [x for x in sorted(S["7d"]["by_model"].items(), key=lambda x: -x[1]) if x[1] > 0 and not x[0].startswith("<")][:4]:
            L.append(f"<tt>{esc(m)[:22]:<22} {f(n):>7}</tt>")
        self.usage_lbl.set_markup("\n".join(L))
        return False

    # ---------- barra de rolagem (o histórico é do tmux)
    def scroll_tick(self):
        """lê a posição de rolagem do painel ativo e atualiza a barra"""
        if not self.cur or self._scroll_busy or time.time() - self._user_ts < 1.0: return True
        self._scroll_busy = True; proj = self.cur
        def work():
            try:
                r = core.run_tmux(proj, "display-message", "-p", "-t", core.tgt(proj),
                                  "#{scroll_position}|#{history_size}|#{pane_height}").stdout.strip().split("|")
                pos, hist, h = (int(x) if x.strip().isdigit() else 0 for x in (r + ["0", "0", "0"])[:3])
            except Exception:
                pos, hist, h = 0, 0, 0
            GLib.idle_add(self.apply_scroll, proj, pos, hist, h)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_scroll(self, proj, pos, hist, h):
        self._scroll_busy = False
        if proj != self.cur or h <= 0 or time.time() - self._user_ts < 1.0: return False
        self._sync = True
        self.adj.configure(max(0, hist - pos), 0, hist + h, 1, max(1, h - 1), h)
        self._sync = False
        return False

    def on_scroll_user(self, adj):
        if self._sync or not self.cur: return
        self._user_ts = time.time()
        if self._scroll_pending: GLib.source_remove(self._scroll_pending)
        self._scroll_pending = GLib.timeout_add(60, self.do_scroll)

    def do_scroll(self):
        self._scroll_pending = None
        proj = self.cur
        if not proj: return False
        pos = int(round(self.adj.get_upper() - self.adj.get_page_size() - self.adj.get_value()))
        def work():
            if pos <= 0:
                core.run_tmux(proj, "send-keys", "-X", "-t", core.tgt(proj), "cancel")
            else:
                core.run_tmux(proj, "copy-mode", "-t", core.tgt(proj))
                core.run_tmux(proj, "send-keys", "-X", "-t", core.tgt(proj), "goto-line", str(pos))
        threading.Thread(target=work, daemon=True).start()
        return False

    # ---------- painel de agentes
    def toggle_agents(self):
        self.rev.set_reveal_child(not self.rev.get_reveal_child()); self._sig = None; self.agents_tick()

    def agents_tick(self):
        if self.cur and self.rev.get_reveal_child() and not self._busy:
            self._busy = True; proj = self.cur
            def work():
                try:
                    p_ = load().get(proj, {})
                    gd = None if p_.get("host") else core.git_detail_cached(os.path.expanduser(p_.get("dir", "")), ttl=45)
                    data = (core.list_panes(proj), core.sessions(proj), core.mem_recent(proj, 5), gd)
                except Exception: data = ([], {}, [], None)
                GLib.idle_add(self.render_agents, proj, *data)
            threading.Thread(target=work, daemon=True).start()
        return True

    def render_agents(self, proj, panes, sess, mems, gd=None):
        self._busy = False
        if proj != self.cur: return False
        now = time.time()
        sess = {k: v for k, v in sess.items() if v["status"] != "ended" or now - v["last"] < 600}
        sig = json.dumps([[p["id"], p["title"], p["cmd"], p["idle_s"] < 4, p["active"]] for p in panes] +
                         [[v["id"], v["status"], [(a["id"], a["end"] is None) for a in v["subs"].values()]] for v in sess.values()] +
                         [m["path"] for m in mems] +
                         [[c["sha"] for c in (gd or {}).get("commits", [])], [(r_["id"], r_["status"], r_["conclusion"]) for r_ in (gd or {}).get("runs", [])]])
        if sig == self._sig: return False
        self._sig = sig
        vadj = self.asc.get_vadjustment(); vpos = vadj.get_value()      # guarda a rolagem: reconstruir não pode voltar ao topo
        while (r := self.alist.get_first_child()): self.alist.remove(r)
        esc = GLib.markup_escape_text
        def row(markup, act=None, css="ag-row", indent=8):
            r = Gtk.ListBoxRow(); r.act = act
            l = Gtk.Label(use_markup=True, label=markup, xalign=0, wrap=True, margin_start=indent, margin_end=6,
                          margin_top=3, margin_bottom=3)
            l.add_css_class(css); r.set_child(l); r.set_activatable(act is not None); self.alist.append(r)
        def sec(t):
            r = Gtk.ListBoxRow(); r.set_activatable(False)
            l = Gtk.Label(label=t, xalign=0); l.add_css_class("ag-sec"); r.set_child(l); self.alist.append(r)
        COR = {"working": "#a6e3a1", "idle": "#6c7086", "waiting": "#f9e2af", "ended": "#45475a"}
        sec("PAINÉIS")
        for p in panes:
            st = "working" if p["idle_s"] < 4 else "idle"
            row(f'<span foreground="{COR[st]}">●</span>  <b>{esc(p["title"])}</b>  <span foreground="#6c7086">{esc(p["cmd"])}</span>',
                lambda p=p: self.focus_pane(proj, p))
        if sess: sec("SESSÕES DE IA")
        for v in sess.values():
            nome = os.path.basename(v["cwd"] or "") or "?"
            prompt = f'\n<span foreground="#6c7086">{esc(v["prompt"])}</span>' if v["prompt"] and v["status"] == "working" else ""
            row(f'<span foreground="{COR[v["status"]]}">◆</span>  <b>{esc(v["harness"])}</b>  {esc(nome)}  '
                f'<span foreground="#6c7086">{v["status"]}</span>{prompt}',
                (lambda v=v: self.open_transcript(v["transcript"], v["id"])) if v["transcript"] else None)
            for a in v["subs"].values():
                run = a["end"] is None
                dur = "rodando" if run else f'{int(a["end"] - a["start"])}s'
                row(f'<span foreground="{COR["working" if run else "ended"]}">↳</span> {esc(a["type"])}  '
                    f'<span foreground="#6c7086">{dur}</span>',
                    (lambda a=a: self.open_transcript(a["transcript"], a["id"])) if a["transcript"] else None, "ag-sub", 24)
        if gd and gd["commits"]:
            sec(f"COMMITS  ·  {esc(gd['branch'])}")
            for c in gd["commits"]:
                row(f'<span foreground="#cba6f7">{c["sha"]}</span>  {esc(c["msg"][:56])}\n'
                    f'<span foreground="#6c7086">{esc(c["author"])} · há {core.ago(c["ts"])}</span>',
                    lambda c=c: self.open_commit(proj, c["sha"]))
        if gd and gd["runs"]:
            sec("CI / ACTIONS")
            for r_ in gd["runs"]:
                if r_["status"] != "completed": ic, co = "…", "#f9e2af"
                elif r_["conclusion"] == "success": ic, co = "✓", "#a6e3a1"
                elif r_["conclusion"] in ("failure", "timed_out", "startup_failure"): ic, co = "✗", "#f38ba8"
                else: ic, co = "–", "#6c7086"
                row(f'<span foreground="{co}"><b>{ic}</b></span>  {esc(r_["name"][:40])}\n'
                    f'<span foreground="#6c7086">{esc(r_["event"])} · há {core.ago(r_["ts"])}</span>',
                    lambda u=r_["url"]: subprocess.Popen(["xdg-open", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        if mems:
            sec("MEMÓRIA")
            for m in mems: row(f'<span foreground="#cba6f7">{esc(m["kind"])}</span>  {esc(m["text"][:90])}', None, "ag-sub")
        GLib.idle_add(lambda: (vadj.set_value(vpos), False)[1])
        return False

    def focus_pane(self, proj, p):
        def work():
            core.run_tmux(proj, "select-window", "-t", f"={core.sess(proj)}:{p['window']}")
            core.run_tmux(proj, "select-pane", "-t", p["id"])
        threading.Thread(target=work, daemon=True).start()
        if proj in self.terms: self.terms[proj].grab_focus()

    def open_commit(self, proj, sha):
        d = pdir(proj)
        self.add_pane(f"git {sha}", f"sh -c {shlex.quote(f'git -C {shlex.quote(d)} -c color.ui=always show --stat --patch {sha} | less -R')}")

    def open_transcript(self, path, sid):
        if path and os.path.exists(path):
            self.add_pane(f"log {sid[:6]}", f"{RAIDPOINT} transcript {shlex.quote(path)} -f")

    # ---------- git / PR
    def git_tick(self):
        proj = self.cur; p = load().get(proj) if proj else None
        if not p or p.get("host"):
            self.sub.set_label("" if not p else "servidor remoto"); return True
        d = os.path.expanduser(p["dir"])
        def work():
            try:
                txt = git_summary(d, self.pr_cache, proj)
                g = core.git_detail_cached(d, ttl=60)
                if g and g["runs"]:
                    ic = {"ok": "✓", "fail": "✗", "running": "…", "other": "–"}[g["ci"]]
                    txt += f"  CI {ic} {core.ago(g['runs'][0]['ts'])}"
            except Exception: txt = ""
            GLib.idle_add(lambda: self.sub.set_label(txt) if self.cur == proj else None)
        threading.Thread(target=work, daemon=True).start()
        return True

    # ---------- pedidos de aprovação dos agentes (MCP)
    def req_tick(self):
        if self._asking: return True
        for f in sorted(core.REQDIR.glob("*.json")):
            try: r = json.loads(f.read_text())
            except Exception: continue
            if r.get("status") != "pending": continue
            if time.time() - r.get("ts", 0) > 130:
                f.unlink(missing_ok=True); continue
            self._asking = True; self.ask(f, r); break
        return True

    def ask(self, f, r):
        self.win.present()
        n = Gio.Notification.new("/dev/raid: um agente pede permissão"); n.set_body(f"Projeto {r['project']}")
        self.send_notification("req", n)
        titulos = {"secret": "Um agente quer usar segredos", "spawn": "Um agente quer abrir um shell",
                   "send": "Um agente quer escrever num shell"}
        dlg = Gtk.AlertDialog(message=titulos.get(r["kind"], "Pedido de um agente"),
                              detail=f"Projeto: {r['project']}\n\n{r['detail']}",
                              buttons=["Negar", "Permitir uma vez"], cancel_button=0, default_button=0)
        def done(d, res):
            try: ok = d.choose_finish(res) == 1
            except GLib.Error: ok = False
            try:
                if f.exists():
                    r["status"] = "approved" if ok else "denied"; f.write_text(json.dumps(r))
            except Exception: pass
            self._asking = False
        dlg.choose(self.win, None, done)

    # ---------- segredos
    def on_changes(self, *_):
        """revisão do que mudou (principal + worktrees dos agentes): diff, reverter arquivo, commitar"""
        if not self.cur: return
        proj = self.cur; p = load().get(proj) or {}
        if p.get("host"):
            self.titulo.set_label("Mudanças: indisponível em projeto remoto"); return
        base = os.path.expanduser(p.get("dir", "~"))
        w = Gtk.Window(title=f"Mudanças — {proj}", transient_for=self.win, default_width=1000, default_height=640)
        st = {"dir": base, "files": [], "sel": None}
        alvos = Gtk.DropDown.new_from_strings([base]); alvos.set_tooltip_text("Pasta (principal ou worktree de um agente)")
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Atualizar")
        top = Gtk.Box(spacing=8); top.append(alvos); top.append(refresh)
        lst = Gtk.ListBox(); lst.add_css_class("lista")
        lsc = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_width=280); lsc.set_child(lst)
        tv = Gtk.TextView(editable=False, monospace=True, cursor_visible=False, left_margin=8, top_margin=6)
        tb = tv.get_buffer()
        for nome, cor in (("add", "#a6e3a1"), ("del", "#f38ba8"), ("hunk", "#89b4fa"), ("meta", "#6c7086")):
            tb.create_tag(nome, foreground=cor)
        dsc = Gtk.ScrolledWindow(hexpand=True, vexpand=True); dsc.set_child(tv)
        rev = Gtk.Button(label="Reverter este arquivo"); rev.add_css_class("perigo"); rev.set_sensitive(False)
        msg = Gtk.Entry(placeholder_text="Mensagem do commit (tudo que está na lista)", hexpand=True)
        ok = Gtk.Button(label="Commitar tudo"); ok.add_css_class("agente")
        info = Gtk.Label(xalign=0); info.add_css_class("ag-sub")
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); left.append(top); left.append(lsc); left.append(rev)
        cols = Gtk.Box(spacing=8); cols.append(left); cols.append(dsc)
        bar = Gtk.Box(spacing=8); bar.append(msg); bar.append(ok)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10, margin_start=10, margin_end=10)
        root.append(cols); root.append(bar); root.append(info)
        cols.set_vexpand(True); w.set_child(root)
        ICON = {"M": "~", "A": "+", "?": "+", "D": "−", "R": "→"}

        def show_diff(txt):
            tb.set_text("")
            if not txt: tb.insert(tb.get_end_iter(), "(sem diferenças para mostrar)"); return
            for ln in txt.splitlines(True):
                tag = ("add" if ln.startswith("+") and not ln.startswith("+++") else
                       "del" if ln.startswith("-") and not ln.startswith("---") else
                       "hunk" if ln.startswith("@@") else
                       "meta" if ln.startswith(("diff ", "index ", "---", "+++", "new file", "deleted file")) else None)
                tb.insert_with_tags_by_name(tb.get_end_iter(), ln, tag) if tag else tb.insert(tb.get_end_iter(), ln)

        def select(row):
            if row is None or not hasattr(row, "item"):
                st["sel"] = None; rev.set_sensitive(False); show_diff(""); return
            st["sel"] = row.item; rev.set_sensitive(True); sta, path = row.item
            def work():
                try: t = core.git_diff(st["dir"], path, sta)
                except Exception as e: t = f"erro: {e}"
                GLib.idle_add(lambda: (st["sel"] == row.item and show_diff(t)) and False)
            threading.Thread(target=work, daemon=True).start()
        lst.connect("row-selected", lambda l, r: select(r))

        def fill(files):
            st["files"] = files or []
            while (r := lst.get_first_child()): lst.remove(r)
            for sta, path in st["files"]:
                r = Gtk.ListBoxRow(); r.item = (sta, path)
                h = Gtk.Box(spacing=8)
                l1 = Gtk.Label(label=ICON.get(sta, "~")); l1.add_css_class({"D": "badge-fail", "M": "badge-wait"}.get(sta, "badge-done"))
                l2 = Gtk.Label(label=path, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.START)
                h.append(l1); h.append(l2); r.set_child(h); lst.append(r)
            ok.set_sensitive(bool(st["files"]))
            info.set_label(f"{len(st['files'])} arquivo(s) alterado(s)" if st["files"] else "Nada para commitar.")
            show_diff("")
            if st["files"]: lst.select_row(lst.get_row_at_index(0))

        def reload(*_):
            d = st["dir"]
            def work():
                try: ch = core.git_changes(d)
                except Exception: ch = None
                GLib.idle_add(lambda: (fill(ch) if ch is not None else info.set_label("Não é um repositório git.")) and False)
            threading.Thread(target=work, daemon=True).start()
        refresh.connect("clicked", reload)

        def targets():
            try: ts = core.git_targets(base)
            except Exception: ts = []
            GLib.idle_add(lambda: (set_targets(ts)) and False)
        def set_targets(ts):
            if not ts: return
            st["ts"] = ts
            alvos.set_model(Gtk.StringList.new([f"{n}  —  {pth}" for n, pth in ts]))
            st["dir"] = ts[0][1]
        def troca(*_):
            ts = st.get("ts") or []; i = alvos.get_selected()
            if 0 <= i < len(ts) and ts[i][1] != st["dir"]: st["dir"] = ts[i][1]; reload()
        alvos.connect("notify::selected", troca)

        def do_rev(*_):
            if not st["sel"]: return
            sta, path = st["sel"]
            dlg = Gtk.AlertDialog(message=f"Reverter {path}?", detail="As mudanças deste arquivo serão descartadas e não dá para desfazer.",
                                  buttons=["Cancelar", "Reverter"], cancel_button=0, default_button=0)
            def done(d, res):
                try:
                    if d.choose_finish(res) != 1: return
                except GLib.Error: return
                def work():
                    err = core.git_revert(st["dir"], path, sta)
                    GLib.idle_add(lambda: (info.set_label(f"erro: {err}") if err else reload()) and False)
                threading.Thread(target=work, daemon=True).start()
            dlg.choose(w, None, done)
        rev.connect("clicked", do_rev)

        def do_commit(*_):
            m = msg.get_text()
            if not m.strip(): info.set_label("Escreva a mensagem do commit."); return
            ok.set_sensitive(False)
            def work():
                good, out = core.git_commit(st["dir"], m)
                def fim():
                    if good: msg.set_text("")
                    info.set_label(("Commit feito." if good else "Falhou: " + out[:200]))
                    reload(); return False
                GLib.idle_add(fim)
            threading.Thread(target=work, daemon=True).start()
        ok.connect("clicked", do_commit); msg.connect("activate", do_commit)
        kc = Gtk.EventControllerKey()
        kc.connect("key-pressed", lambda c, kv, kcode, stt: (w.close(), True)[1] if kv == Gdk.KEY_Escape else False)
        w.add_controller(kc)
        w.present(); threading.Thread(target=targets, daemon=True).start(); reload()

    def on_secrets(self, *_):
        if not self.cur: return
        proj = self.cur
        w = Gtk.Window(title=f"Segredos — {proj}", transient_for=self.win, modal=True, default_width=400, default_height=420)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
        info = Gtk.Label(label="Os agentes só veem os NOMES. O valor entra no ambiente de um comando, "
                               "depois que você aprova, e é mascarado na saída.", wrap=True, xalign=0)
        info.add_css_class("ag-sub")
        lst = Gtk.ListBox(); lst.add_css_class("lista")
        sc = Gtk.ScrolledWindow(vexpand=True); sc.set_child(lst)
        nome = Gtk.Entry(placeholder_text="NOME_DA_VARIAVEL")
        valor = Gtk.PasswordEntry(placeholder_text="valor", show_peek_icon=True)
        ok = Gtk.Button(label="Salvar segredo"); ok.add_css_class("agente")
        def fill():
            while (r := lst.get_first_child()): lst.remove(r)
            for n in core.secret_names(proj):
                r = Gtk.ListBoxRow(); h = Gtk.Box(spacing=8)
                h.append(Gtk.Label(label=n, xalign=0, hexpand=True))
                b = Gtk.Button(icon_name="edit-delete-symbolic", has_frame=False)
                b.connect("clicked", lambda _b, n=n: (core.secret_rm(proj, n), fill()))
                h.append(b); r.set_child(h); lst.append(r)
        def save_(*_):
            n, v = nome.get_text().strip(), valor.get_text()
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", n) and v:
                core.secret_set(proj, n, v); nome.set_text(""); valor.set_text(""); fill()
        ok.connect("clicked", save_)
        for x in (info, sc, nome, valor, ok): box.append(x)
        w.set_child(box); fill(); w.present()

    # ---------- repositórios do GitHub (clonados sob demanda em ~/.raid_point/workspaces/<repo>)
    def repo_filter(self, row):
        q = self.busca.get_text().strip().lower(); r = row.repo
        return not q or q in r["nameWithOwner"].lower() or q in (r.get("description") or "").lower()

    def refresh_repos(self, force=False):
        if not force and time.time() - self._repos_ts < 300 and self.repos: return
        self._repos_ts = time.time(); self.rcount.set_label("carregando do GitHub…")
        def work():
            try:
                ok = core.gh_ok(); repos = core.gh_repos(force) if ok else []
            except Exception:
                ok, repos = False, []
            GLib.idle_add(self.render_repos, repos, ok)
        threading.Thread(target=work, daemon=True).start()

    def render_repos(self, repos, ok=True):
        while (r := self.rlist.get_first_child()): self.rlist.remove(r)
        if not ok:
            self.rcount.set_label("GitHub: rode `gh auth login` no terminal"); return False
        self.repos = repos
        projdirs = {os.path.realpath(os.path.expanduser(p.get("dir", ""))) for p in load().values()
                    if isinstance(p, dict) and not p.get("host")}
        for rp in repos:
            row = Gtk.ListBoxRow(); row.repo = rp; row.set_tooltip_text(rp.get("description") or rp["nameWithOwner"])
            box = Gtk.Box(spacing=10)
            av = self.avatar(rp["name"])
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
            n = Gtk.Label(label=rp["name"], xalign=0, ellipsize=Pango.EllipsizeMode.END); n.add_css_class("nome")
            pa = Gtk.Label(label=rp["owner"] + (" · privado" if rp.get("isPrivate") else ""), xalign=0,
                           ellipsize=Pango.EllipsizeMode.END); pa.add_css_class("repo-pai")
            txt.append(n); txt.append(pa); box.append(av); box.append(txt)
            wp = core.workspace_path(rp["nameWithOwner"])
            if os.path.realpath(str(wp)) in projdirs:
                d = Gtk.Label(label="●", tooltip_text="já é um projeto"); d.add_css_class("ponto-proj"); box.append(d)
            elif not (wp / ".git").exists():
                d = Gtk.Label(label="↓", tooltip_text="ainda não clonado: será clonado ao abrir"); d.add_css_class("repo-pai"); box.append(d)
            row.set_child(box); self.rlist.append(row)
        self.rcount.set_label(f"{len(repos)} repositórios no GitHub")
        return False

    def open_repo(self, rp):
        """clona (se preciso) em ~/.raid_point/workspaces/<repo>, vira projeto e abre"""
        nwo = rp["nameWithOwner"]
        if nwo in self._cloning: return                       # já está clonando (clique duplo)
        self._cloning.add(nwo); self.rcount.set_label(f"clonando {rp['name']}…")
        def work():
            try: path, err = core.ensure_workspace(nwo)
            except Exception as e: path, err = None, str(e)
            GLib.idle_add(self.after_clone, rp, path, err)
        threading.Thread(target=work, daemon=True).start()

    def after_clone(self, rp, path, err):
        self._cloning.discard(rp["nameWithOwner"])
        self.rcount.set_label(f"{len(self.repos)} repositórios no GitHub")
        if err or not path:
            Gtk.AlertDialog(message="Não consegui clonar o repositório", detail=f"{rp['nameWithOwner']}\n\n{err}").show(self.win)
            return False
        name = next((n for n, p in load().items() if isinstance(p, dict) and not p.get("host")
                     and os.path.realpath(os.path.expanduser(p.get("dir", ""))) == os.path.realpath(path)), None)
        if not name:
            name = core.unique_name(core.safe_name(rp["name"]), taken_dir=path)
            setp(lambda db: db.setdefault(name, {"dir": path, "startup": [], "github": rp["nameWithOwner"]}))
        self.refresh_list(); self.tab_proj.set_active(True); self.open(name); self._repos_ts = 0
        return False

    def add_project_dir(self, path):
        name = core.unique_name(core.safe_name(os.path.basename(path.rstrip("/"))), taken_dir=path)
        setp(lambda db: db.__setitem__(name, {"dir": path, "startup": []}))
        self.refresh_list(); self.open(name); self._repos_ts = 0

    def on_add(self, *_):
        dlg = Gtk.FileDialog(title="Pasta do projeto")
        def done(d, res):
            try: f = d.select_folder_finish(res)
            except GLib.Error: return
            path = f.get_path()
            if core.git_root(path):
                self.add_project_dir(path); return
            q = Gtk.AlertDialog(message="Esta pasta não é um repositório git",
                                detail="Projetos do /dev/raid são baseados em git (histórico, worktree por agente, PRs). "
                                       "Inicializar um repositório aqui?",
                                buttons=["Cancelar", "git init"], cancel_button=0, default_button=1)
            def d2(dd, rr):
                try: ok = dd.choose_finish(rr) == 1
                except GLib.Error: return
                if ok:
                    subprocess.run(["git", "-C", path, "init"], capture_output=True)
                    self.add_project_dir(path)
            q.choose(self.win, None, d2)
        dlg.select_folder(self.win, None, done)

    def on_add_remote(self, *_):
        hosts = ssh_hosts()
        if not hosts:
            return
        w = Gtk.Window(title="Servidor remoto", transient_for=self.win, modal=True, default_width=380)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        host = Gtk.DropDown.new_from_strings(hosts)
        nome = Gtk.Entry(placeholder_text="Nome do projeto (padrão: nome do host)")
        pasta = Gtk.Entry(placeholder_text="Pasta no servidor (opcional)")
        trans = Gtk.DropDown.new_from_strings(["mosh", "ssh"] if shutil.which("mosh") else ["ssh"])
        ok = Gtk.Button(label="Conectar"); ok.add_css_class("agente")
        for lab, wd in [("Servidor (do ~/.ssh/config)", host), ("Nome", nome), ("Pasta", pasta), ("Conexão", trans)]:
            l = Gtk.Label(label=lab, xalign=0); l.add_css_class("side-titulo"); box.append(l); box.append(wd)
        box.append(ok); w.set_child(box)
        def go(*_):
            h = hosts[host.get_selected()]
            n = core.safe_name(nome.get_text().strip() or h)
            reg = {"dir": pasta.get_text().strip(), "host": h,
                   "transport": trans.get_selected_item().get_string(), "startup": []}
            setp(lambda db: db.__setitem__(n, reg)); w.close(); self.refresh_list(); self.open(n)
        ok.connect("clicked", go); w.present()

    def on_remove(self, *_):
        if not self.cur: return
        name = self.cur
        dlg = Gtk.AlertDialog(message=f"Remover '{name}'?",
                              detail="Isso encerra os terminais desse projeto.",
                              buttons=["Cancelar", "Remover"], cancel_button=0, default_button=0)
        def done(d, res):
            try:
                if d.choose_finish(res) != 1: return
            except GLib.Error: return
            if not load().get(name, {}).get("host"):
                tmux("kill-session", "-t", core.sess_t(name))
            setp(lambda db: db.pop(name, None))
            t = self.terms.pop(name, None)
            if t: self.stack.remove(t)
            self.cur = None; self.stack.set_visible_child_name("_vazio")
            self.titulo.set_label("/dev/raid"); self.refresh_list()
        dlg.choose(self.win, None, done)

if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
