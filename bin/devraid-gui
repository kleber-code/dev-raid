                       ("Alt+\\  /  Alt+-", "split side by side / below"), ("Alt+t", "new tab"),
                       ("Alt+1…9", "go to tab N"), ("Alt+z", "zoom the pane"), ("Alt+w", "close pane (asks first)"),
                       ("Ctrl+PageUp/PageDown", "previous / next tab")]:
            h = Gtk.Box(spacing=12); l1 = Gtk.Label(label=a_, xalign=0, width_request=190); l1.add_css_class("ag-row")
            l2 = Gtk.Label(label=b_, xalign=0); l2.add_css_class("ag-sub"); h.append(l1); h.append(l2); k.append(h)

        # --- Agents
        g = page("agents", "Agents", "The programs that show up in ＋ Agent and in the palette. Empty command = just a shell.")
        container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); g.append(container)
        state = [dict(a) for a in agents()]
        def persist():
            core.save_agents(state)
        def build():
            while (r := container.get_first_child()): container.remove(r)
            for i, a in enumerate(state):
                h = Gtk.Box(spacing=8)
                n = Gtk.Entry(text=a["name"], placeholder_text="name", width_chars=14)
                c = Gtk.Entry(text=a.get("cmd", ""), placeholder_text="command (e.g. claude)", hexpand=True)
                n.connect("changed", lambda e, a=a: (a.__setitem__("name", e.get_text()), persist()))
                c.connect("changed", lambda e, a=a: (a.__setitem__("cmd", e.get_text()), persist()))
                rm = Gtk.Button(icon_name="edit-delete-symbolic", has_frame=False)
                rm.connect("clicked", lambda _b, i=i: (state.pop(i), persist(), build()))
                h.append(n); h.append(c); h.append(rm); container.append(h)
        build()
        add_btn = Gtk.Button(label="＋ Add agent", halign=Gtk.Align.START)
        add_btn.connect("clicked", lambda *_: (state.append({"name": "New", "cmd": ""}), persist(), build()))
        g.append(add_btn)

        # --- Advanced
        v = page("advanced", "Advanced", "Where the app's files live.")
        mode = core.install_mode()
        upd = Gtk.Switch(active=bool(self.cfg.get("updates", {}).get("auto", True)), sensitive=mode != "package")
        def upd_changed(*_):
            self.cfg.setdefault("updates", {})["auto"] = upd.get_active(); save()
        upd.connect("notify::active", upd_changed)
        row(v, "Automatic updates", {"git": "Pulls new commits into this checkout (fast-forward only, never over local changes).",
                                     "release": "Installs new releases from GitHub in the background.",
                                     "package": "Installed by your distro package: update it with your package manager."}[mode], upd)
        for label, path in [("Configuration", core.HOME / "config.toml"), ("Agents", core.CFG / "agents.json"),
                            ("Data (memory, events)", core.DATA), ("GitHub workspaces", core.WS)]:
            h = Gtk.Box(spacing=12); l1 = Gtk.Label(label=label, xalign=0, width_request=190)
            l2 = Gtk.Label(label=str(path), xalign=0, selectable=True, hexpand=True); l2.add_css_class("ag-sub")
            bt = Gtk.Button(label="Open"); bt.connect("clicked", lambda _b, c=path: self.open_uri(str(c)))
            h.append(l1); h.append(l2); h.append(bt); v.append(h)
        kc2 = Gtk.EventControllerKey()
        kc2.connect("key-pressed", lambda c, kv, kcode, stt: (w.close(), True)[1] if kv == Gdk.KEY_Escape and not capturing["k"] else False)
