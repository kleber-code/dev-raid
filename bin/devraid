#!/usr/bin/env python3
"""devraid - single entry point of /dev/raid.

  devraid                 open the app (window)
  devraid here [dir]      terminal in a folder (or that project's session); also: devraid term
  devraid ssh <host>      connect to a server (alias or user@host) in a persistent session
  devraid <command> ...   CLI: ls, add, rm, open, repos, usage, mem, secret, mcp, hook, install, update, ...
  devraid --version
"""
import os, sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, ".."))
from raidpoint.core import VERSION

def main():
    a = sys.argv[1:]
    if a[:1] in (["--version"], ["-V"], ["version"]):
        print(f"devraid {VERSION}"); return
    if (not a or a[0] in ("gui", "--gui", "here", "term", "--here", "ssh")) and not os.path.exists(os.path.join(HERE, "devraid-gui")):
        # server install (install.sh --headless): there is no window, everything is the CLI
        if a: sys.exit("this is a server install of /dev/raid (no app). See: devraid help")
        os.execv(sys.executable, [sys.executable, os.path.join(HERE, "raidpoint"), "help"])
    if not a or a[0] in ("gui", "--gui"):
        target = os.path.join(HERE, "devraid-gui")
        os.execv(sys.executable, [sys.executable, target])
    if a[0] in ("here", "term", "--here"):       # plain terminal in a folder (default: current), or that project's session
        d = os.path.abspath(os.path.expanduser(a[1])) if len(a) > 1 else os.getcwd()
        os.execv(sys.executable, [sys.executable, os.path.join(HERE, "devraid-gui"), "--here", d])
    if a[0] == "ssh":                            # connect to a server in a persistent session: devraid ssh <host|user@host>
        if len(a) < 2: sys.exit("usage: devraid ssh <host | user@host>")
        os.execv(sys.executable, [sys.executable, os.path.join(HERE, "devraid-gui"), "--ssh", a[1]])
    target = os.path.join(HERE, "raidpoint")
    os.execv(sys.executable, [sys.executable, target, *a])

if __name__ == "__main__":
    main()
