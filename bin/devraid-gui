def setp(fn):
    """write to projects.json (lock + atomic write); if the file is unreadable, write nothing"""
    try: return core.update_projects(fn)
    except Exception as e:
        print("warning: could not write projects.json:", e, file=sys.stderr); return None

def color(name):
    return PALETTE[int(hashlib.md5(name.encode()).hexdigest(), 16) % len(PALETTE)]

