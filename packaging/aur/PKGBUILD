# Maintainer: kleber-code <https://github.com/kleber-code>
pkgname=devraid
pkgver=0.2.0
pkgrel=1
pkgdesc='Orchestrate many AI coding agents (Claude Code, Codex, Aider) in persistent terminals, one workspace per project'
arch=('any')
url='https://github.com/kleber-code/dev-raid'
license=('MIT')
depends=('python>=3.11' 'python-gobject' 'gtk4' 'vte4' 'tmux' 'github-cli' 'libsecret')
optdepends=('mosh: remote projects over mosh'
            'gnome-keyring: store per-project secrets in the system keyring'
            'noto-fonts: default terminal font')
makedepends=('make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2d69bf184f5d1099129446c29b792b837148e642e00f2c592ea1345278c38631')

package() {
  cd "dev-raid-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
