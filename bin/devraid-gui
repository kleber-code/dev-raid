        # --- Shortcuts
        k = page("shortcuts", "Shortcuts", "Click a shortcut and press the new combination. Backspace removes, Esc cancels.")
        LABELS = [("palette", "Open actions (command palette)"), ("settings", "Open settings"),
                  ("changes", "Changes / diff / commit"), ("agents_panel", "Agents panel"),
                  ("sidebar", "Project list"), ("chat", "Chat with the orchestrator"), ("zoom_in", "Larger text"), ("zoom_out", "Smaller text"),
                  ("zoom_reset", "Normal text"), ("copy", "Copy"), ("paste", "Paste")]
        capturing = {"k": None}
        buttons = {}
        def readable(acc):
            if not acc: return "—"
            ok, kv, md = Gtk.accelerator_parse(acc)
            return Gtk.accelerator_get_label(kv, md) if ok else acc
        def apply():
            save(); self.rebuild_binds(); self.apply_accels()
        for key_id, label in LABELS:
            b = Gtk.Button(label=readable(self.cfg["keys"].get(key_id, "")), width_request=190)
            buttons[key_id] = b
            def clicked(_b, key_id=key_id):
                if capturing["k"]: buttons[capturing["k"]].set_label(readable(self.cfg["keys"].get(capturing["k"], "")))
                capturing["k"] = key_id; buttons[key_id].set_label("press the combination…")
            b.connect("clicked", clicked); row(k, label, "", b)
        kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def on_key(c, kv, kcode, stt):
            ch = capturing["k"]
            if not ch: return False
            if kv in (Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R, Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
                      Gdk.KEY_Super_L, Gdk.KEY_Super_R, Gdk.KEY_Meta_L, Gdk.KEY_Meta_R): return True
            if kv == Gdk.KEY_Escape: pass
            elif kv == Gdk.KEY_BackSpace: self.cfg["keys"][ch] = ""; apply()
            else:
                md = stt & Gtk.accelerator_get_default_mod_mask()
                acc = Gtk.accelerator_name(Gdk.keyval_to_lower(kv), md)
                owner = [o for o, v in self.cfg["keys"].items() if v == acc and o != ch]
                if owner: buttons[ch].set_label("already used by: " + owner[0]); capturing["k"] = None; return True
                self.cfg["keys"][ch] = acc; apply()
            buttons[ch].set_label(readable(self.cfg["keys"].get(ch, ""))); capturing["k"] = None
            return True
        kc.connect("key-pressed", on_key); w.add_controller(kc)
        sep = Gtk.Label(label="Fixed in tmux (move and split panes, work inside any project)", xalign=0, margin_top=14)
        sep.add_css_class("ag-sec"); k.append(sep)
