#!/usr/bin/env python3
"""raidpoint - /dev/raid CLI: event hook, MCP server, memory, secrets, installation.

  raidpoint [open] <project>     open/return to the project in the terminal (tmux)
  raidpoint ls | add <name> [dir] | rm <name> | kill <name> | stop
  raidpoint repos                list your GitHub repositories
  raidpoint open-repo <owner/repo> clone into ~/.raid_point/workspaces/<repo> and register it as a project
  raidpoint hook                 (harness JSON on stdin; logs an event)
  raidpoint mcp                  stdio MCP server (list_agents, spawn_agent, send_message, ...)
  raidpoint mem add|search|recent|reindex ...
  raidpoint secret set|list|rm <project> [NAME]
  raidpoint usage                Claude Code token usage (5h / 24h / 7d, per project)
  raidpoint statusline           (Claude Code JSON on stdin) stores plan limits and prints "5h x% · 7d y%"
  raidpoint install-statusline   enable the statusLine in Claude Code (only if you don't have one)
  raidpoint events               recent events
  raidpoint transcript <file> [-f]
  raidpoint install              register hooks + MCP in Claude Code and Codex
  raidpoint update [--check]     update /dev/raid (--check: only report whether an update exists)
  raidpoint plugin ls | info|enable|disable|tools <name>   manage MCP plugins (~/.raid_point/plugins)
"""
import atexit, json, os, sys, time, shutil, subprocess
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from raidpoint import core, plugins
from raidpoint.tools import TOOLS, CATALOG_VERSION

SELF = os.path.realpath(__file__)

# ------------------------------------------------------------------ hook
def cmd_hook():
    try:
        d = json.load(sys.stdin)
    except Exception:
        return
    try:
        cwd = d.get("cwd") or os.getcwd()
        proj = core.project_for_cwd(cwd)
        ev = d.get("hook_event_name", "?")
        if not isinstance(ev, str): return
        core.log_event({"harness": "claude", "event": ev, "session_id": d.get("session_id"), "cwd": cwd,
                        "project": proj, "transcript": d.get("transcript_path"),
                        "agent_id": d.get("agent_id"), "agent_type": d.get("agent_type"),
                        "agent_transcript": d.get("agent_transcript_path"),
                        "prompt": (d.get("prompt") or "")[:80] if ev == "UserPromptSubmit" else None,
                        "message": (d.get("message") or "")[:200] if ev == "Notification" else None})
        if ev == "SessionStart" and proj:
            mems = core.mem_recent(proj, 8)
            if mems:
                print(f"# Memory of project '{proj}' (/dev/raid)\n"
                      "Use the MCP tools raidpoint.memory_search / memory_add to look up and record decisions.\n")
                for m in mems:
                    print(f"- [{m['kind']}] {m['text'][:240]}")
    except Exception:
        pass

# ------------------------------------------------------------------ MCP
_HOST = None
def _host():
    """enabled plugins (started on first use; closed when the MCP server exits)"""
    global _HOST
    if _HOST is None:
        _HOST = plugins.Host(); _HOST.load()
        atexit.register(_HOST.close)
    return _HOST

def cmd_mcp():
    def send(o): sys.stdout.write(json.dumps(o, ensure_ascii=False) + "\n"); sys.stdout.flush()
    for line in sys.stdin:
        try: m = json.loads(line)
        except Exception: continue
        if not isinstance(m, dict): continue
        i, meth = m.get("id"), m.get("method")
        try:
            params = m.get("params") or {}
            if meth == "initialize":
                send({"jsonrpc": "2.0", "id": i, "result": {"protocolVersion": params.get("protocolVersion", "2024-11-05"),
                      "capabilities": {"tools": {}}, "serverInfo": {"name": "raidpoint", "version": "0.3"}}})
            elif meth == "ping":
                send({"jsonrpc": "2.0", "id": i, "result": {}})
            elif meth == "tools/list":
                send({"jsonrpc": "2.0", "id": i, "result": {"tools": [
                    {"name": n, "description": d, "inputSchema": sc} for n, (d, sc, _) in TOOLS.items()] + _host().list_tools(),
                    "_meta": {"devraid/catalogVersion": CATALOG_VERSION}}})
            elif meth == "tools/call":
                n, a = params.get("name"), params.get("arguments") or {}
                if n not in TOOLS and n in _host().index:       # plugin tool: already an MCP result
                    send({"jsonrpc": "2.0", "id": i, "result": _host().call(n, a)}); continue
                try:
                    if n not in TOOLS: raise ValueError(f"unknown tool: {n}")
                    res = TOOLS[n][2](a); err = False
                except Exception as e:
                    res, err = {"error": str(e)}, True
                send({"jsonrpc": "2.0", "id": i, "result": {"isError": err or (isinstance(res, dict) and "error" in res),
                      "content": [{"type": "text", "text": json.dumps(res, ensure_ascii=False, indent=1, default=str)}]}})
            elif i is not None:
                send({"jsonrpc": "2.0", "id": i, "error": {"code": -32601, "message": "unknown method"}})
        except Exception as e:                                   # never takes the server down
            if i is not None:
                send({"jsonrpc": "2.0", "id": i, "error": {"code": -32603, "message": f"internal error: {e}"}})

# ------------------------------------------------------------------ plugins
def cmd_plugin(a):
    sub, name = (a + ["", ""])[:2]
    if sub in ("ls", "list", ""):
        found = plugins.discover()
        if not found: print(f"no plugins (put them in {plugins.PLUGINS}/<name>/plugin.toml)"); return
        for s in found:
            print(f"{s['name']:<20} {s['state']:<9} {s.get('version', ''):<8} {s.get('description') or s.get('error', '')}")
        return
    try:
        if sub == "info":
            s = plugins.status(name)
            if s["state"] == "invalid": sys.exit(f"{name}: {s['error']}")
            print(f"{s['name']} {s['version']} [{s['state']}]\n{s['description']}\ncommand:     {' '.join(s['command'])}"
                  f"\npermissions: {', '.join(s['permissions']) or '(none declared)'}"
                  f"\nenv:         {', '.join(s['env_passthrough']) or '(none passed through)'}\nsha256:      {s['hash']}")
        elif sub == "enable":
            s = plugins.status(name)
            if s["state"] == "invalid": sys.exit(f"{name}: {s['error']}")
            print(f"Enabling '{name}' lets /dev/raid RUN this command on your machine, with your user's privileges:\n"
                  f"  {' '.join(s['command'])}\npermissions: {', '.join(s['permissions']) or '(none declared)'}\n"
                  f"env passed through: {', '.join(s['env_passthrough']) or '(none)'}")
            if "--yes" not in a and input("Enable this plugin? [y/N] ").strip().lower() != "y": sys.exit("aborted")
            plugins.enable(name); print(f"enabled {name}")
        elif sub == "disable":
            plugins.disable(name); print(f"disabled {name}")
        elif sub == "tools":
            h = plugins.Host(only=name); h.load()
            try:
                if name not in h.clients: sys.exit(f"{name}: not running ({h.errors.get(name, 'not enabled')})")
                for full, (_, t) in h.index.items():
                    ro = (t.get("annotations") or {}).get("readOnlyHint")
                    print(f"{full:<40} {'read-only' if ro else 'asks approval':<14} {(t.get('description') or '')[:70]}")
            finally: h.close()
        else: print(__doc__)
    except plugins.PluginError as e:
        sys.exit(f"{name}: {e}")

# ------------------------------------------------------------------ helper CLI
def cmd_mem(a):
    sub = a[0] if a else ""
    if sub == "reindex": core.mem_reindex(); print("ok"); return
    proj = a[1] if len(a) > 1 else core.project_for_cwd(os.getcwd())
    if not proj: sys.exit("no project: run inside a project folder or pass its name (raidpoint mem <add|search|recent> <project> ...)")
    if sub == "add": print(core.mem_add(proj, " ".join(a[2:])))
    elif sub == "search":
        for m in core.mem_search(proj, " ".join(a[2:])): print(f"[{m['kind']}] {m['ts']}  {m['text'][:200]}")
    elif sub == "recent":
        for m in core.mem_recent(proj): print(f"[{m['kind']}] {m['ts']}  {m['text'][:200]}")
    else: print(__doc__)

def cmd_secret(a):
    import getpass
    sub, proj = (a + ["", ""])[:2]; name = a[2] if len(a) > 2 else ""
    if sub == "set" and name:
        print("ok" if core.secret_set(proj, name, getpass.getpass(f"value of {name}: ")) else "failed")
    elif sub == "list": print("\n".join(core.secret_names(proj)))
    elif sub == "rm" and name: print("ok" if core.secret_rm(proj, name) else "failed")
    else: print(__doc__)

def cmd_transcript(a):
    path, follow = a[0], "-f" in a
    def show(l):
        try: o = json.loads(l)
        except Exception: return
        msg = o.get("message") or {}; role = msg.get("role") or o.get("type", "?")
        c = msg.get("content")
        if isinstance(c, list):
            c = " ".join((x.get("text") or (f"[{x['name']}]" if x.get("type") == "tool_use" else "") or "") for x in c if isinstance(x, dict))
        if c: print(f"\033[35m{role:>9}\033[0m {str(c)[:600]}", flush=True)
    with open(path) as f:
        for l in f: show(l)
        while follow:
            l = f.readline()
            if l: show(l)
            else: time.sleep(0.5)

def cmd_install():
    # 1) Claude Code hooks (removes the old "termos" ones)
    sp = os.path.expanduser("~/.claude/settings.json")
    s = json.load(open(sp)); shutil.copy(sp, sp + ".raidpoint.bak")
    hooks = s.setdefault("hooks", {})
    cmd = f"{SELF} hook"
    for ev, lst in list(hooks.items()):
        for g in lst:
            g["hooks"] = [h for h in g.get("hooks", []) if "/termos hook" not in h.get("command", "")]
        hooks[ev] = [g for g in lst if g.get("hooks")]
        if not hooks[ev]: del hooks[ev]
    for ev in ["SessionStart", "SessionEnd", "UserPromptSubmit", "Stop", "Notification", "SubagentStart", "SubagentStop"]:
        lst = hooks.setdefault(ev, [])
        if not any(cmd in h.get("command", "") for g in lst for h in g.get("hooks", [])):
            lst.append({"matcher": "", "hooks": [{"type": "command", "command": cmd, "timeout": 10}]})
    core.write_json_atomic(sp, s)
    print("Claude Code hooks: ok (backup in settings.json.raidpoint.bak)")
    # 2) MCP in Claude Code
    subprocess.run(["claude", "mcp", "remove", "--scope", "user", "termos"], capture_output=True)
    r = subprocess.run(["claude", "mcp", "add", "--scope", "user", "raidpoint", "--", SELF, "mcp"], text=True, capture_output=True)
    print("MCP Claude Code:", (r.stdout + r.stderr).strip()[:160] or "ok")
    # 3) MCP in Codex
    import re as _re
    cp = os.path.expanduser("~/.codex/config.toml")
    if os.path.exists(cp):
        t = open(cp).read(); shutil.copy(cp, cp + ".raidpoint.bak")
        t = _re.sub(r"\n?\[mcp_servers\.(termos|raidpoint)\]\n(?:[^\[\n][^\n]*\n?)*", "", t)
        t += f'\n[mcp_servers.raidpoint]\ncommand = "{SELF}"\nargs = ["mcp"]\n'
        open(cp, "w").write(t); print("MCP Codex: ok")

# ------------------------------------------------------------------ projects (terminal)
def cmd_ls():
    on = core.alive()
    for n, p in core.load_projects().items():
        print(f"{'●' if core.sess(n) in on else '○'} {n:<22} {p.get('host', '') + ':' if p.get('host') else ''}{p.get('dir', '')}")

def cmd_add(a):
    name = core.safe_name(a[0]); d = os.path.abspath(os.path.expanduser(a[1])) if len(a) > 1 else os.getcwd()
    if subprocess.run(["git", "-C", d, "rev-parse"], capture_output=True).returncode != 0:
        if input(f"{d} is not a git repository. Initialize it? [y/N] ").strip().lower() not in ("y", "yes"):
            sys.exit("/dev/raid projects must be git repositories. Aborted.")
        subprocess.run(["git", "-C", d, "init"], check=True)
    core.update_projects(lambda db: db.__setitem__(name, {"dir": d, "startup": []}))
    print(f"ok: {name} -> {d}")

def cmd_open(name):
    p = core.load_projects().get(name)
    if not p: sys.exit(f"project '{name}' does not exist. Use: raidpoint add {name} [dir]")
    if p.get("host"):
        argv = core.remote_argv(name, p)
        os.execvp(argv[0], argv)
    d = os.path.expanduser(p["dir"])
    if core.sess(name) not in core.alive():
        subprocess.run(core.TMUX + ["new-session", "-d", "-s", core.sess(name), "-c", d], check=True)
    verb = "switch-client" if f"/{core.SOCKET}," in os.environ.get("TMUX", "") else "attach-session"
    os.execvp("tmux", core.TMUX + [verb, "-t", core.sess_t(name)])

def cmd_open_repo(nwo):
    path, err = core.ensure_workspace(nwo)
    if err: sys.exit(err)
    name = core.unique_name(core.safe_name(nwo.split("/")[1]), taken_dir=path)
    core.update_projects(lambda db: db.setdefault(name, {"dir": path, "startup": [], "github": nwo}))
    print(f"{name} -> {path}")

def cmd_statusline():
    """Claude Code statusLine: receives the JSON on stdin; stores rate_limits and prints a short line"""
    try: d = json.load(sys.stdin)
    except Exception: return
    rl = d.get("rate_limits") or {}
    f, w = rl.get("five_hour"), rl.get("seven_day")
    try:
        if f or w:
            tmp = core.PLAN_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps({"ts": time.time(), "five_hour": f, "seven_day": w,
                                       "session_id": d.get("session_id"), "model": (d.get("model") or {}).get("display_name")}))
            os.replace(tmp, core.PLAN_FILE)
    except Exception: pass
    parts = []
    if f and f.get("used_percentage") is not None: parts.append(f"5h {f['used_percentage']:.0f}%")
    if w and w.get("used_percentage") is not None: parts.append(f"7d {w['used_percentage']:.0f}%")
    if parts: print(" · ".join(parts))

def cmd_install_statusline():
    sp = os.path.expanduser("~/.claude/settings.json")
    s = json.load(open(sp))
    if s.get("statusLine"):
        sys.exit(f"you already have a statusLine configured: {s['statusLine']}. Not overwriting it.")
    shutil.copy(sp, sp + ".statusline.bak")
    s["statusLine"] = {"type": "command", "command": f"{SELF} statusline"}
    core.write_json_atomic(sp, s)
    print("statusLine enabled (backup in settings.json.statusline.bak). Applies to new Claude Code sessions.")

def main():
    a = sys.argv[1:]
    c = a[0] if a else ""
    if c == "hook": cmd_hook()
    elif c == "mcp": cmd_mcp()
    elif c == "mem": cmd_mem(a[1:])
    elif c == "secret": cmd_secret(a[1:])
    elif c == "transcript": cmd_transcript(a[1:])
    elif c == "install": cmd_install()
    elif c == "update":
        r = core.check_update(apply="--check" not in a)
        print(f"[{r['status']}] {r['msg']}"); sys.exit(1 if r["status"] == "error" else 0)
    elif c == "ls": cmd_ls()
    elif c == "add" and len(a) > 1: cmd_add(a[1:])
    elif c == "rm" and len(a) == 2: core.update_projects(lambda db: db.pop(a[1], None))
    elif c == "kill" and len(a) == 2: subprocess.run(core.TMUX + ["kill-session", "-t", core.sess_t(a[1])])
    elif c == "stop": subprocess.run(core.TMUX + ["kill-server"])
    elif c == "repos":
        if not core.gh_ok(): sys.exit("gh is not authenticated: run `gh auth login`")
        for r in core.gh_repos(force=True):
            print(f"{'●' if (core.workspace_path(r['nameWithOwner']) / '.git').exists() else '○'} {r['nameWithOwner']:<40} {'private' if r['isPrivate'] else ''}")
    elif c == "open-repo" and len(a) == 2: cmd_open_repo(a[1])
    elif c == "statusline": cmd_statusline()
    elif c == "install-statusline": cmd_install_statusline()
    elif c == "usage":
        S = core.usage_summary(); f = core.fmt_tokens
        for w, o in S.items():
            print(f"{w:>3}  new {f(o['new']):>7}  output {f(o['out']):>6}  cache read {f(o['cache_read']):>7}  {o['msgs']} msgs")
        pl = core.plan_status()
        if pl and (pl.get("five_hour") or pl.get("seven_day")):
            for label, k in (("5h", "five_hour"), ("week", "seven_day")):
                w = pl.get(k)
                if w: print(f"plan {label}: {w.get('used_percentage', 0):.0f}% used, resets {time.strftime('%d/%m %H:%M', time.localtime(w['resets_at']))}  (data from {int(pl['age_s'] // 60)} min ago)")
        else: print("plan: no data (enable with `raidpoint install-statusline`)")
        cx = core.codex_plan()
        if cx:
            for label, k in (("5h", "primary"), ("week", "secondary")):
                w = cx.get(k)
                if w and w.get("used_percent") is not None:
                    print(f"codex {label}: {w['used_percent']:.0f}% used, resets {time.strftime('%d/%m %H:%M', time.localtime(w['resets_at']))}  (plan {cx.get('plan_type')}, data from {core.ago(cx['ts'])} ago)")
            cr = cx.get("credits") or {}
            print("codex credits:", "unlimited" if cr.get("unlimited") else (cr.get("balance") if cr.get("has_credits") else "no extra credits"))
        print("\nper project (7d):")
        for p, n in sorted(S["7d"]["by_project"].items(), key=lambda x: -x[1])[:8]: print(f"  {p:<24} {f(n):>7}")
    elif c == "plugin": cmd_plugin(a[1:])
    elif c == "events":
        for e in core.read_events()[-30:]: print(time.strftime("%H:%M:%S", time.localtime(e["ts"])), e.get("event"), e.get("project"), e.get("agent_type") or "", e.get("session_id", "")[:8])
    elif c in ("-h", "--help", "help", ""): print(__doc__)
    elif c in ("open", "abrir") and len(a) > 1: cmd_open(a[1])     # "abrir": legacy alias of "open"
    else: cmd_open(c[len("abrir "):] if c.startswith("abrir ") else c)

if __name__ == "__main__":
    main()
