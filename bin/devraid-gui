    def open_config(self):
        core.load_config()                                   # makes sure the file exists
        self.open_uri(str(core.HOME / "config.toml"))

    def open_uri(self, uri):
        try: subprocess.Popen(["xdg-open", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception: pass

    def pane_at(self, name, term, x, y):
        """id of the tmux pane under the pointer (None if not found)"""
        cw, ch = term.get_char_width(), term.get_char_height()
        if cw <= 0 or ch <= 0: return None
        col, row = int((x - 12) // cw), int((y - 10) // ch)      # 12/10 = terminal CSS padding
        info = core.run_tmux(name, "display-message", "-p", "-t", core.tgt(name), "#{status}|#{status-position}", timeout=5).stdout.strip().split("|")
        if len(info) == 2 and info[0] not in ("off", "0") and info[1] == "top": row -= 1   # tab bar line
        r = core.run_tmux(name, "list-panes", "-t", core.tgt(name), "-F",
                          "#{pane_id} #{pane_left} #{pane_top} #{pane_right} #{pane_bottom}", timeout=5)
        for l in r.stdout.splitlines():
            try: pid, l_, t_, r_, b_ = l.split(); l_, t_, r_, b_ = int(l_), int(t_), int(r_), int(b_)
            except ValueError: continue
            if l_ <= col <= r_ and t_ - 1 <= row <= b_:          # t_-1: the border with the title sits above
                return pid
        return None

    def pane_action(self, name, fut, *cmd, cwd=False):
        """run a tmux command on the pane under the mouse (waits for the lookup to finish; falls back to the active pane)"""
        def work():
            fut["th"].join(6)
            pane = fut.get("pane") or core.tgt(name)
            extra = ["-c", pdir(name)] if cwd and pdir(name) else []
            if cmd[0] == "break-pane":          # in break-pane, -s is the source pane (-t would be the destination)
                core.run_tmux(name, "break-pane", "-s", pane, *cmd[1:])
            elif cmd[0] == "new-window":        # a new tab belongs to the SESSION (a pane id as target would give 'index in use')
                core.run_tmux(name, "new-window", "-t", core.tgt(name), *cmd[1:], *extra)
            else:
                core.run_tmux(name, cmd[0], "-t", pane, *cmd[1:], *extra)
        threading.Thread(target=work, daemon=True).start()

    def confirm_kill(self, name, fut):
        dlg = Gtk.AlertDialog(message="Close this pane?", detail="The process running in it will be terminated.",
                              buttons=["Cancel", "Close pane"], cancel_button=0, default_button=0)
        def done(d, res):
            try:
                if d.choose_finish(res) == 1: self.pane_action(name, fut, "kill-pane")
            except GLib.Error: pass
        dlg.choose(self.win, None, done)

    def show_ctx(self, name, term, x, y):
        link = self.link_at(term, x, y)
        fut = {"pane": None}
        def calc():
            try: fut["pane"] = self.pane_at(name, term, x, y)
            except Exception: pass
        fut["th"] = threading.Thread(target=calc, daemon=True); fut["th"].start()
        pop = Gtk.Popover(has_arrow=False); pop.set_parent(term)
        r = Gdk.Rectangle(); r.x, r.y, r.width, r.height = int(x), int(y), 1, 1; pop.set_pointing_to(r)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=4, margin_bottom=4, margin_start=4, margin_end=4)
        def item(txt, cb, css=None):
            b = Gtk.Button(label=txt, has_frame=False); b.get_child().set_xalign(0); b.add_css_class("pop-item")
            if css: b.add_css_class(css)
            b.connect("clicked", lambda *_: (pop.popdown(), cb())); box.append(b)
        def sep(): box.append(Gtk.Separator())
        if link:
            item("Open link", lambda: self.open_uri(link)); item("Copy link", lambda: self.set_clipboard(link)); sep()
        item("Copy", lambda: self.do_copy(name))
        item("Paste", lambda: term.paste_clipboard())
        sep()
        item("Split right  (side by side)", lambda: self.pane_action(name, fut, "split-window", "-h", cwd=True))
        item("Split below", lambda: self.pane_action(name, fut, "split-window", "-v", cwd=True))
        item("Zoom this pane", lambda: self.pane_action(name, fut, "resize-pane", "-Z"))
        item("Move to new tab", lambda: self.pane_action(name, fut, "break-pane"))
        item("New tab", lambda: self.pane_action(name, fut, "new-window", cwd=True))
        sep()
        item("Close pane…", lambda: self.confirm_kill(name, fut), "danger")
        pop.set_child(box)
        pop.connect("closed", lambda p: GLib.idle_add(p.unparent))
        pop.popup()

    def clip_tick(self):
        """anything copied inside tmux (mouse or copy mode) goes to the system clipboard"""
        if not self.cur or self._clip_busy: return True
        proj = self.cur
        if load().get(proj, {}).get("host") and time.time() - self._clip_last_t < 2: return True
        self._clip_busy = True; self._clip_last_t = time.time()
        def work():
            try:
                r = core.run_tmux(proj, "show-buffer", timeout=5)
                txt = r.stdout if r.returncode == 0 else ""
            except Exception:
                txt = None
            GLib.idle_add(self.clip_apply, proj, txt)
        threading.Thread(target=work, daemon=True).start()
        return True

    def clip_apply(self, proj, txt):
        self._clip_busy = False
        if txt is None: return False
        prev = self._buf.get(proj); self._buf[proj] = txt
        if prev is not None and txt != prev and txt.strip():
            self.set_clipboard(txt)
        return False

    # ---------- auto-update
    def update_tick(self, force=False):
        def work():
            r = core.auto_update(force=force)
            if r: GLib.idle_add(self.on_update_result, r, force)
        threading.Thread(target=work, daemon=True).start()
        return True

    def on_update_result(self, r, manual):
        if r["status"] == "updated":
            n = Gio.Notification.new("/dev/raid updated")
            n.set_body(f"{r['msg']}. Restart to apply (your terminals stay open).")
            n.add_button("Restart now", "app.restart")
            self.send_notification("update", n)
        elif manual:
            n = Gio.Notification.new("/dev/raid: " + {"current": "up to date", "error": "update failed"}.get(r["status"], "update skipped"))
            n.set_body(r["msg"]); self.send_notification("update", n)
        return False

    def restart(self):
        """re-exec the app; tmux sessions live in their own server, so every terminal survives"""
        os.execv(sys.executable, [sys.executable, os.path.realpath(sys.argv[0]), *sys.argv[1:]])

    # ---------- notifications: agent finished / needs you
    def notify(self, proj, title, body):
        n = Gio.Notification.new(title); n.set_body(body)
        n.set_default_action_and_target("app.open-project", GLib.Variant.new_string(proj))
        self.send_notification(f"ag-{proj}", n)

    def ev_tick(self):
        evs = [e for e in core.read_events(max_age=120) if e["ts"] > self._ev_ts]
        if not evs: return True
        self._ev_ts = max(e["ts"] for e in evs)
        projs = set(self.names())
        for e in evs:
            p = e.get("project")
            if p not in projs: continue
            ev = e.get("event"); watching = self.win.is_active() and p == self.cur
            if ev == "UserPromptSubmit": self.attn[p] = "working"
            elif ev == "SessionEnd": self.attn.pop(p, None)
            elif ev == "Stop":
                if watching: self.attn.pop(p, None)
                else:
                    self.attn[p] = "done"; self.notify(p, f"{p}: finished", "The agent (Claude Code) finished responding.")
            elif ev == "Notification" and not watching:
                self.attn[p] = "waiting"; self.notify(p, f"{p}: needs you", e.get("message") or "The agent is waiting for a reply.")
        self.update_badges()
        return True

    def update_badges(self):
        for n, b in self.badges.items():
            for c in ("badge-wait", "badge-done", "badge-work", "badge-fail"): b.remove_css_class(c)
            a = self.attn.get(n); ci = self.ci.get(n)
            if a == "waiting": b.set_label("!"); b.add_css_class("badge-wait"); b.set_tooltip_text("the agent needs you")
            elif a == "done": b.set_label("✓"); b.add_css_class("badge-done"); b.set_tooltip_text("the agent finished")
            elif a == "working": b.set_label("…"); b.add_css_class("badge-work"); b.set_tooltip_text("the agent is working")
            elif ci: b.set_label("✗"); b.add_css_class("badge-fail"); b.set_tooltip_text(ci)
            else: b.set_label(""); b.set_tooltip_text(None)

    def ci_tick(self):
        db = load(); targets = {n: os.path.expanduser(p["dir"]) for n, p in db.items()
                                if isinstance(p, dict) and p.get("dir") and not p.get("host") and not n.startswith("_")}
        def work():
            res = {}
            for n, d in targets.items():
                try: g = core.git_detail_cached(d, ttl=100)
                except Exception: g = None
                if g and g["ci"] == "fail" and g["runs"] and time.time() - g["runs"][0]["ts"] < 3 * 86400:
                    res[n] = f"CI failed: {g['runs'][0]['name']} ({core.ago(g['runs'][0]['ts'])})"
            GLib.idle_add(self.set_ci, res)
        threading.Thread(target=work, daemon=True).start()
        return True

    def set_ci(self, res):
        self.ci = res; self.update_badges(); return False

    # ---------- Claude Code usage
    def usage_tick(self):
        def work():
            try: S = core.usage_summary()
            except Exception: return
            GLib.idle_add(self.render_usage, S)
        threading.Thread(target=work, daemon=True).start()
        return True

    def render_usage(self, S):
        f = core.fmt_tokens; esc = GLib.markup_escape_text
        pl = core.plan_status(); fh = (pl or {}).get("five_hour")
        if fh and fh.get("used_percentage") is not None and pl["age_s"] < 1800:
            self.usage_btn.set_label(f"◔ 5h {fh['used_percentage']:.0f}%")
        else:
            self.usage_btn.set_label(f"◔ 5h {f(S['5h']['new'])}")
        cx5 = core.codex_plan()
        if cx5 and cx5.get("primary") and cx5["age_s"] < 6 * 3600 and cx5["primary"].get("used_percent") is not None:
            self.usage_btn.set_label(self.usage_btn.get_label() + f" · cx {cx5['primary']['used_percent']:.0f}%")
        for label, k, lim in (("5 hours", "five_hour", 80), ("week", "seven_day", 85)):
            w = (pl or {}).get(k)
            if w and w.get("used_percentage", 0) >= lim and (k, w.get("resets_at")) not in self._plan_alerted:
                self._plan_alerted.add((k, w.get("resets_at")))
                n = Gio.Notification.new(f"Plan limit ({label}): {w['used_percentage']:.0f}%")
                n.set_body("Resets " + time.strftime("%d/%m %H:%M", time.localtime(w["resets_at"]))); self.send_notification(f"plan-{k}", n)
        L = []
        if pl and (pl.get("five_hour") or pl.get("seven_day")):
            L.append("<b>Plan</b>  <span foreground='#6c7086'>(Claude Code data from %d min ago)</span>" % (pl["age_s"] // 60))
            for label, k in (("5 hours", "five_hour"), ("week", "seven_day")):
                w = pl.get(k)
                if w and w.get("used_percentage") is not None:
                    pct = w["used_percentage"]; color_ = "#f38ba8" if pct >= 85 else ("#f9e2af" if pct >= 60 else "#a6e3a1")
                    rs = time.strftime("%d/%m %H:%M", time.localtime(w["resets_at"])) if w.get("resets_at") else "?"
                    L.append(f"<tt>{label:<8}</tt><span foreground='{color_}'><b>{pct:>3.0f}%</b></span>  <span foreground='#6c7086'>resets {rs}</span>")
            L.append("")
        else:
            L.append("<span foreground='#6c7086'>Plan: no data. Enable with: raidpoint install-statusline</span>\n")
        cx = core.codex_plan()
        if cx and (cx.get("primary") or cx.get("secondary")):
            L.append("<b>Codex</b>  <span foreground='#6c7086'>plan %s · data from %s ago</span>" % (cx.get("plan_type") or "?", core.ago(cx["ts"])))
            for label, k in (("5 hours", "primary"), ("week", "secondary")):
                w = cx.get(k)
                if w and w.get("used_percent") is not None:
                    pct = w["used_percent"]; color_ = "#f38ba8" if pct >= 85 else ("#f9e2af" if pct >= 60 else "#a6e3a1")
                    rs = time.strftime("%d/%m %H:%M", time.localtime(w["resets_at"])) if w.get("resets_at") else "?"
                    L.append(f"<tt>{label:<8}</tt><span foreground='{color_}'><b>{pct:>3.0f}%</b></span>  <span foreground='#6c7086'>resets {rs}</span>")
            cr = cx.get("credits") or {}
            if cr.get("unlimited"): L.append("<tt>credits  </tt>unlimited")
            elif cr.get("has_credits"): L.append(f"<tt>credits  </tt><b>{esc(str(cr.get('balance', '?')))}</b>")
            L.append("")
        L += ["<b>Claude Code — tokens</b>  <span foreground='#6c7086'>(input + output + cache created)</span>"]
        for w in ("5h", "24h", "7d"):
            o = S[w]
            L.append(f"<tt>{w:>3}  {f(o['new']):>7}   output {f(o['out']):>6}   cache read {f(o['cache_read']):>7}   {o['msgs']} msgs</tt>")
        L.append("\n<b>By project (7d)</b>")
        for p, n in sorted(S["7d"]["by_project"].items(), key=lambda x: -x[1])[:6]:
            L.append(f"<tt>{esc(p)[:22]:<22} {f(n):>7}</tt>")
        L.append("\n<b>By model (7d)</b>")
        for m, n in [x for x in sorted(S["7d"]["by_model"].items(), key=lambda x: -x[1]) if x[1] > 0 and not x[0].startswith("<")][:4]:
            L.append(f"<tt>{esc(m)[:22]:<22} {f(n):>7}</tt>")
        self.usage_lbl.set_markup("\n".join(L))
        return False

    # ---------- scrollbar (the history belongs to tmux)
    def scroll_tick(self):
        """read the active pane's scroll position and update the bar"""
        if not self.cur or self._scroll_busy or time.time() - self._user_ts < 1.0: return True
        self._scroll_busy = True; proj = self.cur
        def work():
            try:
                r = core.run_tmux(proj, "display-message", "-p", "-t", core.tgt(proj),
                                  "#{scroll_position}|#{history_size}|#{pane_height}").stdout.strip().split("|")
                pos, hist, h = (int(x) if x.strip().isdigit() else 0 for x in (r + ["0", "0", "0"])[:3])
            except Exception:
                pos, hist, h = 0, 0, 0
            GLib.idle_add(self.apply_scroll, proj, pos, hist, h)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_scroll(self, proj, pos, hist, h):
        self._scroll_busy = False
        if proj != self.cur or h <= 0 or time.time() - self._user_ts < 1.0: return False
        self._sync = True
        self.adj.configure(max(0, hist - pos), 0, hist + h, 1, max(1, h - 1), h)
        self._sync = False
        return False

    def on_scroll_user(self, adj):
        if self._sync or not self.cur: return
        self._user_ts = time.time()
        if self._scroll_pending: GLib.source_remove(self._scroll_pending)
        self._scroll_pending = GLib.timeout_add(60, self.do_scroll)

    def do_scroll(self):
        self._scroll_pending = None
        proj = self.cur
        if not proj: return False
        pos = int(round(self.adj.get_upper() - self.adj.get_page_size() - self.adj.get_value()))
        def work():
            if pos <= 0:
                core.run_tmux(proj, "send-keys", "-X", "-t", core.tgt(proj), "cancel")
            else:
                core.run_tmux(proj, "copy-mode", "-t", core.tgt(proj))
                core.run_tmux(proj, "send-keys", "-X", "-t", core.tgt(proj), "goto-line", str(pos))
        threading.Thread(target=work, daemon=True).start()
        return False

    # ---------- agents panel
    def toggle_chat(self):
        on = not self.chat_rev.get_reveal_child()
        self.chat_rev.set_reveal_child(on); self.chat.set_active(on)
        if not on and self.cur in self.terms: self.terms[self.cur].grab_focus()

    def toggle_agents(self):
        self.rev.set_reveal_child(not self.rev.get_reveal_child()); self._sig = None; self.agents_tick()

    def agents_tick(self):
        if self.cur and self.rev.get_reveal_child() and not self._busy:
            self._busy = True; proj = self.cur
            def work():
                try:
                    p_ = load().get(proj, {})
                    gd = None if p_.get("host") else core.git_detail_cached(os.path.expanduser(p_.get("dir", "")), ttl=45)
                    data = (core.list_panes(proj), core.sessions(proj), core.mem_recent(proj, 5), gd)
                except Exception: data = ([], {}, [], None)
                GLib.idle_add(self.render_agents, proj, *data)
            threading.Thread(target=work, daemon=True).start()
        return True

    def render_agents(self, proj, panes, sess, mems, gd=None):
        self._busy = False
        if proj != self.cur: return False
        now = time.time()
        sess = {k: v for k, v in sess.items() if v["status"] != "ended" or now - v["last"] < 600}
        sig = json.dumps([[p["id"], p["title"], p["cmd"], p["idle_s"] < 4, p["active"]] for p in panes] +
                         [[v["id"], v["status"], [(a["id"], a["end"] is None) for a in v["subs"].values()]] for v in sess.values()] +
                         [m["path"] for m in mems] +
                         [[c["sha"] for c in (gd or {}).get("commits", [])], [(r_["id"], r_["status"], r_["conclusion"]) for r_ in (gd or {}).get("runs", [])]])
        if sig == self._sig: return False
        self._sig = sig
        vadj = self.asc.get_vadjustment(); vpos = vadj.get_value()      # keep the scroll position: rebuilding must not jump to the top
        while (r := self.alist.get_first_child()): self.alist.remove(r)
        esc = GLib.markup_escape_text
        def row(markup, act=None, css="ag-row", indent=8):
            r = Gtk.ListBoxRow(); r.act = act
            l = Gtk.Label(use_markup=True, label=markup, xalign=0, wrap=True, margin_start=indent, margin_end=6,
                          margin_top=3, margin_bottom=3)
            l.add_css_class(css); r.set_child(l); r.set_activatable(act is not None); self.alist.append(r)
        def sec(t):
            r = Gtk.ListBoxRow(); r.set_activatable(False)
            l = Gtk.Label(label=t, xalign=0); l.add_css_class("ag-sec"); r.set_child(l); self.alist.append(r)
        COLOR = {"working": "#a6e3a1", "idle": "#6c7086", "waiting": "#f9e2af", "ended": "#45475a"}
        sec("PANES")
        for p in panes:
            st = "working" if p["idle_s"] < 4 else "idle"
            row(f'<span foreground="{COLOR[st]}">●</span>  <b>{esc(p["title"])}</b>  <span foreground="#6c7086">{esc(p["cmd"])}</span>',
                lambda p=p: self.focus_pane(proj, p))
        if sess: sec("AI SESSIONS")
        for v in sess.values():
            name = os.path.basename(v["cwd"] or "") or "?"
            prompt = f'\n<span foreground="#6c7086">{esc(v["prompt"])}</span>' if v["prompt"] and v["status"] == "working" else ""
            row(f'<span foreground="{COLOR[v["status"]]}">◆</span>  <b>{esc(v["harness"])}</b>  {esc(name)}  '
                f'<span foreground="#6c7086">{v["status"]}</span>{prompt}',
                (lambda v=v: self.open_transcript(v["transcript"], v["id"])) if v["transcript"] else None)
            for a in v["subs"].values():
                run = a["end"] is None
                dur = "running" if run else f'{int(a["end"] - a["start"])}s'
                row(f'<span foreground="{COLOR["working" if run else "ended"]}">↳</span> {esc(a["type"])}  '
                    f'<span foreground="#6c7086">{dur}</span>',
                    (lambda a=a: self.open_transcript(a["transcript"], a["id"])) if a["transcript"] else None, "ag-sub", 24)
        if gd and gd["commits"]:
            sec(f"COMMITS  ·  {esc(gd['branch'])}")
            for c in gd["commits"]:
                row(f'<span foreground="#cba6f7">{c["sha"]}</span>  {esc(c["msg"][:56])}\n'
                    f'<span foreground="#6c7086">{esc(c["author"])} · {core.ago(c["ts"])} ago</span>',
                    lambda c=c: self.open_commit(proj, c["sha"]))
        if gd and gd["runs"]:
            sec("CI / ACTIONS")
            for r_ in gd["runs"]:
                if r_["status"] != "completed": ic, co = "…", "#f9e2af"
                elif r_["conclusion"] == "success": ic, co = "✓", "#a6e3a1"
                elif r_["conclusion"] in ("failure", "timed_out", "startup_failure"): ic, co = "✗", "#f38ba8"
                else: ic, co = "–", "#6c7086"
                row(f'<span foreground="{co}"><b>{ic}</b></span>  {esc(r_["name"][:40])}\n'
                    f'<span foreground="#6c7086">{esc(r_["event"])} · {core.ago(r_["ts"])} ago</span>',
                    lambda u=r_["url"]: subprocess.Popen(["xdg-open", u], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        if mems:
            sec("MEMORY")
            for m in mems: row(f'<span foreground="#cba6f7">{esc(m["kind"])}</span>  {esc(m["text"][:90])}', None, "ag-sub")
        GLib.idle_add(lambda: (vadj.set_value(vpos), False)[1])
        return False

    def focus_pane(self, proj, p):
        def work():
            core.run_tmux(proj, "select-window", "-t", f"={core.sess(proj)}:{p['window']}")
            core.run_tmux(proj, "select-pane", "-t", p["id"])
        threading.Thread(target=work, daemon=True).start()
        if proj in self.terms: self.terms[proj].grab_focus()

    def open_commit(self, proj, sha):
        d = pdir(proj)
        self.add_pane(f"git {sha}", f"sh -c {shlex.quote(f'git -C {shlex.quote(d)} -c color.ui=always show --stat --patch {sha} | less -R')}")

    def open_transcript(self, path, sid):
        if path and os.path.exists(path):
            self.add_pane(f"log {sid[:6]}", f"{RAIDPOINT} transcript {shlex.quote(path)} -f")

    # ---------- git / PR
    def git_tick(self):
        proj = self.cur; p = load().get(proj) if proj else None
        if not p or p.get("host"):
            self.sub.set_label("" if not p else "remote server"); return True
        d = os.path.expanduser(p["dir"])
        def work():
            try:
                txt = git_summary(d, self.pr_cache, proj)
                g = core.git_detail_cached(d, ttl=60)
                if g and g["runs"]:
                    ic = {"ok": "✓", "fail": "✗", "running": "…", "other": "–"}[g["ci"]]
                    txt += f"  CI {ic} {core.ago(g['runs'][0]['ts'])}"
            except Exception: txt = ""
            GLib.idle_add(lambda: self.sub.set_label(txt) if self.cur == proj else None)
        threading.Thread(target=work, daemon=True).start()
        return True

    # ---------- approval requests from agents (MCP)
    def req_tick(self):
        if self._asking: return True
        for f in sorted(core.REQDIR.glob("*.json")):
            try: r = json.loads(f.read_text())
            except Exception: continue
            if r.get("status") != "pending": continue
            if time.time() - r.get("ts", 0) > 130:
                f.unlink(missing_ok=True); continue
            self._asking = True; self.ask(f, r); break
        return True

    def ask(self, f, r):
        self.win.present()
        n = Gio.Notification.new("/dev/raid: an agent is asking for permission"); n.set_body(f"Project {r['project']}")
        self.send_notification("req", n)
        titles = {"secret": "An agent wants to use secrets", "spawn": "An agent wants to open a shell",
                  "send": "An agent wants to type into a shell",
                  "plugin": "A plugin wants to run a tool"}
        dlg = Gtk.AlertDialog(message=titles.get(r["kind"], "Request from an agent"),
                              detail=f"Project: {r['project']}\n\n{r['detail']}",
                              buttons=["Deny", "Allow once"], cancel_button=0, default_button=0)
        def done(d, res):
            try: ok = d.choose_finish(res) == 1
            except GLib.Error: ok = False
            try:
                if f.exists():
                    r["status"] = "approved" if ok else "denied"; f.write_text(json.dumps(r))
            except Exception: pass
            self._asking = False
        dlg.choose(self.win, None, done)

    # ---------- changes and secrets
    def on_changes(self, *_):
        """review what changed (main + agent worktrees): diff, revert a file, commit"""
        if not self.cur: return
        proj = self.cur; p = load().get(proj) or {}
        if p.get("host"):
            self.title_lbl.set_label("Changes: unavailable for remote projects"); return
        base = os.path.expanduser(p.get("dir", "~"))
        w = Gtk.Window(title=f"Changes — {proj}", transient_for=self.win, default_width=1000, default_height=640)
        st = {"dir": base, "files": [], "sel": None}
        target_dd = Gtk.DropDown.new_from_strings([base]); target_dd.set_tooltip_text("Folder (main or an agent's worktree)")
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        top = Gtk.Box(spacing=8); top.append(target_dd); top.append(refresh)
        lst = Gtk.ListBox(); lst.add_css_class("rp-list")
        lsc = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_width=280); lsc.set_child(lst)
        tv = Gtk.TextView(editable=False, monospace=True, cursor_visible=False, left_margin=8, top_margin=6)
        tb = tv.get_buffer()
        for tag_name, fg in (("add", "#a6e3a1"), ("del", "#f38ba8"), ("hunk", "#89b4fa"), ("meta", "#6c7086")):
            tb.create_tag(tag_name, foreground=fg)
        dsc = Gtk.ScrolledWindow(hexpand=True, vexpand=True); dsc.set_child(tv)
        rev = Gtk.Button(label="Revert this file"); rev.add_css_class("danger"); rev.set_sensitive(False)
        msg = Gtk.Entry(placeholder_text="Commit message (everything in the list)", hexpand=True)
        ok = Gtk.Button(label="Commit all"); ok.add_css_class("agent")
        info = Gtk.Label(xalign=0); info.add_css_class("ag-sub")
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); left.append(top); left.append(lsc); left.append(rev)
        cols = Gtk.Box(spacing=8); cols.append(left); cols.append(dsc)
        bar = Gtk.Box(spacing=8); bar.append(msg); bar.append(ok)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10, margin_start=10, margin_end=10)
        root.append(cols); root.append(bar); root.append(info)
        cols.set_vexpand(True); w.set_child(root)
        ICON = {"M": "~", "A": "+", "?": "+", "D": "−", "R": "→"}

        def show_diff(txt):
            tb.set_text("")
            if not txt: tb.insert(tb.get_end_iter(), "(no differences to show)"); return
            for ln in txt.splitlines(True):
                tag = ("add" if ln.startswith("+") and not ln.startswith("+++") else
                       "del" if ln.startswith("-") and not ln.startswith("---") else
                       "hunk" if ln.startswith("@@") else
                       "meta" if ln.startswith(("diff ", "index ", "---", "+++", "new file", "deleted file")) else None)
                tb.insert_with_tags_by_name(tb.get_end_iter(), ln, tag) if tag else tb.insert(tb.get_end_iter(), ln)

        def select(row):
            if row is None or not hasattr(row, "item"):
                st["sel"] = None; rev.set_sensitive(False); show_diff(""); return
            st["sel"] = row.item; rev.set_sensitive(True); sta, path = row.item
            def work():
                try: t = core.git_diff(st["dir"], path, sta)
                except Exception as e: t = f"error: {e}"
                GLib.idle_add(lambda: (st["sel"] == row.item and show_diff(t)) and False)
            threading.Thread(target=work, daemon=True).start()
        lst.connect("row-selected", lambda l, r: select(r))

        def fill(files):
            st["files"] = files or []
            while (r := lst.get_first_child()): lst.remove(r)
            for sta, path in st["files"]:
                r = Gtk.ListBoxRow(); r.item = (sta, path)
                h = Gtk.Box(spacing=8)
                l1 = Gtk.Label(label=ICON.get(sta, "~")); l1.add_css_class({"D": "badge-fail", "M": "badge-wait"}.get(sta, "badge-done"))
                l2 = Gtk.Label(label=path, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.START)
                h.append(l1); h.append(l2); r.set_child(h); lst.append(r)
            ok.set_sensitive(bool(st["files"]))
            info.set_label(f"{len(st['files'])} file(s) changed" if st["files"] else "Nothing to commit.")
            show_diff("")
            if st["files"]: lst.select_row(lst.get_row_at_index(0))

        def reload(*_):
            d = st["dir"]
            def work():
                try: ch = core.git_changes(d)
                except Exception: ch = None
                GLib.idle_add(lambda: (fill(ch) if ch is not None else info.set_label("Not a git repository.")) and False)
            threading.Thread(target=work, daemon=True).start()
        refresh.connect("clicked", reload)

        def targets():
            try: ts = core.git_targets(base)
            except Exception: ts = []
            GLib.idle_add(lambda: (set_targets(ts)) and False)
        def set_targets(ts):
            if not ts: return
            st["ts"] = ts
            target_dd.set_model(Gtk.StringList.new([f"{n}  —  {pth}" for n, pth in ts]))
            st["dir"] = ts[0][1]
        def switch_target(*_):
            ts = st.get("ts") or []; i = target_dd.get_selected()
            if 0 <= i < len(ts) and ts[i][1] != st["dir"]: st["dir"] = ts[i][1]; reload()
        target_dd.connect("notify::selected", switch_target)

        def do_rev(*_):
            if not st["sel"]: return
            sta, path = st["sel"]
            dlg = Gtk.AlertDialog(message=f"Revert {path}?", detail="This file's changes will be discarded and this can't be undone.",
                                  buttons=["Cancel", "Revert"], cancel_button=0, default_button=0)
            def done(d, res):
                try:
                    if d.choose_finish(res) != 1: return
                except GLib.Error: return
                def work():
                    err = core.git_revert(st["dir"], path, sta)
                    GLib.idle_add(lambda: (info.set_label(f"error: {err}") if err else reload()) and False)
                threading.Thread(target=work, daemon=True).start()
            dlg.choose(w, None, done)
        rev.connect("clicked", do_rev)

        def do_commit(*_):
            m = msg.get_text()
            if not m.strip(): info.set_label("Write the commit message."); return
            ok.set_sensitive(False)
            def work():
                good, out = core.git_commit(st["dir"], m)
                def finish():
                    if good: msg.set_text("")
                    info.set_label(("Committed." if good else "Failed: " + out[:200]))
                    reload(); return False
                GLib.idle_add(finish)
            threading.Thread(target=work, daemon=True).start()
        ok.connect("clicked", do_commit); msg.connect("activate", do_commit)
        kc = Gtk.EventControllerKey()
        kc.connect("key-pressed", lambda c, kv, kcode, stt: (w.close(), True)[1] if kv == Gdk.KEY_Escape else False)
        w.add_controller(kc)
        w.present(); threading.Thread(target=targets, daemon=True).start(); reload()

    def on_secrets(self, *_):
        if not self.cur: return
        proj = self.cur
        w = Gtk.Window(title=f"Secrets — {proj}", transient_for=self.win, modal=True, default_width=400, default_height=420)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=14, margin_bottom=14, margin_start=14, margin_end=14)
        info = Gtk.Label(label="Agents only see the NAMES. The value goes into a command's environment "
                               "after you approve, and is masked in the output.", wrap=True, xalign=0)
        info.add_css_class("ag-sub")
        lst = Gtk.ListBox(); lst.add_css_class("rp-list")
        sc = Gtk.ScrolledWindow(vexpand=True); sc.set_child(lst)
        name_e = Gtk.Entry(placeholder_text="VARIABLE_NAME")
        value_e = Gtk.PasswordEntry(placeholder_text="value", show_peek_icon=True)
        ok = Gtk.Button(label="Save secret"); ok.add_css_class("agent")
        def fill():
            while (r := lst.get_first_child()): lst.remove(r)
            for n in core.secret_names(proj):
                r = Gtk.ListBoxRow(); h = Gtk.Box(spacing=8)
                h.append(Gtk.Label(label=n, xalign=0, hexpand=True))
                b = Gtk.Button(icon_name="edit-delete-symbolic", has_frame=False)
                b.connect("clicked", lambda _b, n=n: (core.secret_rm(proj, n), fill()))
                h.append(b); r.set_child(h); lst.append(r)
        def save_(*_):
            n, v = name_e.get_text().strip(), value_e.get_text()
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", n) and v:
                core.secret_set(proj, n, v); name_e.set_text(""); value_e.set_text(""); fill()
        ok.connect("clicked", save_)
        for x in (info, sc, name_e, value_e, ok): box.append(x)
        w.set_child(box); fill(); w.present()

    # ---------- GitHub repositories (cloned on demand into ~/.raid_point/workspaces/<repo>)
    def repo_filter(self, row):
        q = self.search.get_text().strip().lower(); r = row.repo
        return not q or q in r["nameWithOwner"].lower() or q in (r.get("description") or "").lower()

    def refresh_repos(self, force=False):
        if not force and time.time() - self._repos_ts < 300 and self.repos: return
        self._repos_ts = time.time(); self.rcount.set_label("loading from GitHub…")
        def work():
            try:
                ok = core.gh_ok(); repos = core.gh_repos(force) if ok else []
            except Exception:
                ok, repos = False, []
            GLib.idle_add(self.render_repos, repos, ok)
        threading.Thread(target=work, daemon=True).start()

    def render_repos(self, repos, ok=True):
        while (r := self.rlist.get_first_child()): self.rlist.remove(r)
        if not ok:
            self.rcount.set_label("GitHub: run `gh auth login` in a terminal"); return False
        self.repos = repos
        projdirs = {os.path.realpath(os.path.expanduser(p.get("dir", ""))) for p in load().values()
                    if isinstance(p, dict) and not p.get("host")}
        for rp in repos:
            row = Gtk.ListBoxRow(); row.repo = rp; row.set_tooltip_text(rp.get("description") or rp["nameWithOwner"])
            box = Gtk.Box(spacing=10)
            av = self.avatar(rp["name"])
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
            n = Gtk.Label(label=rp["name"], xalign=0, ellipsize=Pango.EllipsizeMode.END); n.add_css_class("name-lbl")
            pa = Gtk.Label(label=rp["owner"] + (" · private" if rp.get("isPrivate") else ""), xalign=0,
                           ellipsize=Pango.EllipsizeMode.END); pa.add_css_class("repo-owner")
            txt.append(n); txt.append(pa); box.append(av); box.append(txt)
            wp = core.workspace_path(rp["nameWithOwner"])
            if os.path.realpath(str(wp)) in projdirs:
                d = Gtk.Label(label="●", tooltip_text="already a project"); d.add_css_class("dot-proj"); box.append(d)
            elif not (wp / ".git").exists():
                d = Gtk.Label(label="↓", tooltip_text="not cloned yet: will be cloned when opened"); d.add_css_class("repo-owner"); box.append(d)
            row.set_child(box); self.rlist.append(row)
        self.rcount.set_label(f"{len(repos)} repositories on GitHub")
        return False

    def open_repo(self, rp):
        """clone (if needed) into ~/.raid_point/workspaces/<repo>, turn it into a project and open it"""
        nwo = rp["nameWithOwner"]
        if nwo in self._cloning: return                       # already cloning (double click)
        self._cloning.add(nwo); self.rcount.set_label(f"cloning {rp['name']}…")
        def work():
            try: path, err = core.ensure_workspace(nwo)
            except Exception as e: path, err = None, str(e)
            GLib.idle_add(self.after_clone, rp, path, err)
        threading.Thread(target=work, daemon=True).start()

    def after_clone(self, rp, path, err):
        self._cloning.discard(rp["nameWithOwner"])
        self.rcount.set_label(f"{len(self.repos)} repositories on GitHub")
        if err or not path:
            Gtk.AlertDialog(message="Could not clone the repository", detail=f"{rp['nameWithOwner']}\n\n{err}").show(self.win)
            return False
        name = next((n for n, p in load().items() if isinstance(p, dict) and not p.get("host")
                     and os.path.realpath(os.path.expanduser(p.get("dir", ""))) == os.path.realpath(path)), None)
        if not name:
            name = core.unique_name(core.safe_name(rp["name"]), taken_dir=path)
            setp(lambda db: db.setdefault(name, {"dir": path, "startup": [], "github": rp["nameWithOwner"]}))
        self.refresh_list(); self.tab_proj.set_active(True); self.open(name); self._repos_ts = 0
        return False

    def add_project_dir(self, path):
        name = core.unique_name(core.safe_name(os.path.basename(path.rstrip("/"))), taken_dir=path)
        setp(lambda db: db.__setitem__(name, {"dir": path, "startup": []}))
        self.refresh_list(); self.open(name); self._repos_ts = 0

    def on_add(self, *_):
        dlg = Gtk.FileDialog(title="Project folder")
        def done(d, res):
            try: f = d.select_folder_finish(res)
            except GLib.Error: return
            path = f.get_path()
            if core.git_root(path):
                self.add_project_dir(path); return
            q = Gtk.AlertDialog(message="This folder is not a git repository",
                                detail="/dev/raid projects are git-based (history, a worktree per agent, PRs). "
                                       "Initialize a repository here?",
                                buttons=["Cancel", "git init"], cancel_button=0, default_button=1)
            def d2(dd, rr):
                try: ok = dd.choose_finish(rr) == 1
                except GLib.Error: return
                if ok:
                    subprocess.run(["git", "-C", path, "init"], capture_output=True)
                    self.add_project_dir(path)
            q.choose(self.win, None, d2)
        dlg.select_folder(self.win, None, done)

    def on_add_remote(self, *_):
        hosts = ssh_hosts()
        if not hosts:
            return
        w = Gtk.Window(title="Remote server", transient_for=self.win, modal=True, default_width=380)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        host = Gtk.DropDown.new_from_strings(hosts)
        name_e = Gtk.Entry(placeholder_text="Project name (default: host name)")
        folder_e = Gtk.Entry(placeholder_text="Folder on the server (optional)")
        trans = Gtk.DropDown.new_from_strings(["mosh", "ssh"] if shutil.which("mosh") else ["ssh"])
        ok = Gtk.Button(label="Connect"); ok.add_css_class("agent")
        for lab, wd in [("Server (from ~/.ssh/config)", host), ("Name", name_e), ("Folder", folder_e), ("Connection", trans)]:
            l = Gtk.Label(label=lab, xalign=0); l.add_css_class("side-title"); box.append(l); box.append(wd)
        box.append(ok); w.set_child(box)
        def go(*_):
            h = hosts[host.get_selected()]
            n = core.safe_name(name_e.get_text().strip() or h)
            reg = {"dir": folder_e.get_text().strip(), "host": h,
                   "transport": trans.get_selected_item().get_string(), "startup": []}
            setp(lambda db: db.__setitem__(n, reg)); w.close(); self.refresh_list(); self.open(n)
        ok.connect("clicked", go); w.present()

    def on_remove(self, *_):
        if not self.cur: return
        name = self.cur
        dlg = Gtk.AlertDialog(message=f"Remove '{name}'?",
                              detail="This closes this project's terminals.",
                              buttons=["Cancel", "Remove"], cancel_button=0, default_button=0)
        def done(d, res):
            try:
                if d.choose_finish(res) != 1: return
            except GLib.Error: return
            if not load().get(name, {}).get("host"):
                tmux("kill-session", "-t", core.sess_t(name))
            setp(lambda db: db.pop(name, None))
            t = self.terms.pop(name, None)
            if t: self.stack.remove(t)
            self.cur = None; self.stack.set_visible_child_name("_empty")
            self.title_lbl.set_label("/dev/raid"); self.refresh_list()
        dlg.choose(self.win, None, done)

if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
