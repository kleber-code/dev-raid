        self.menu_btn.connect("clicked", lambda *_: self.palette(""))
        hb.pack_end(self.menu_btn)
        hb.pack_end(action_btn("emblem-system-symbolic", "Settings (Ctrl+,)", lambda *_: self.on_settings()))
