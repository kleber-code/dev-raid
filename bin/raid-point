def setp(fn):
    """grava no projects.json (trava + escrita atômica); se o arquivo estiver ilegível, não grava nada"""
    try: return core.update_projects(fn)
    except Exception as e:
        print("aviso: não consegui gravar o projects.json:", e, file=sys.stderr); return None

def cor(nome):
    return PALETA[int(hashlib.md5(nome.encode()).hexdigest(), 16) % len(PALETA)]

