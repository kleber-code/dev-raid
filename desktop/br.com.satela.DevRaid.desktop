[Desktop Entry]
Type=Application
Name=/dev/raid
GenericName=AI agent orchestrator
Comment=Orchestrate many AI coding agents in persistent terminals, one workspace per project
Exec=@BIN@/devraid
Icon=devraid
Terminal=false
Categories=Development;TerminalEmulator;
Keywords=terminal;tmux;ai;agents;claude;codex;aider;
StartupWMClass=br.com.satela.DevRaid
StartupNotify=true
