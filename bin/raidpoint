#!/usr/bin/env python3
"""raidpoint - CLI do Raid Point: hook de eventos, servidor MCP, memória, segredos, instalação.

  raidpoint [abrir] <projeto>    abre/volta ao projeto no terminal (tmux)
  raidpoint ls | add <nome> [dir] | rm <nome> | kill <nome> | stop
  raidpoint repos                lista os repositórios do GitHub
  raidpoint open-repo <dono/repo> clona em ~/.raid_point/workspaces/<repo> e registra como projeto
  raidpoint hook                 (stdin JSON do harness; registra evento)
  raidpoint mcp                  servidor MCP stdio (list_agents, spawn_agent, send_message, ...)
  raidpoint mem add|search|recent|reindex ...
  raidpoint secret set|list|rm <projeto> [NOME]
  raidpoint events               últimos eventos
  raidpoint transcript <arq> [-f]
  raidpoint install              registra hooks + MCP no Claude Code e Codex
"""
import json, os, sys, time, shutil, subprocess
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from raidpoint import core

SELF = os.path.realpath(__file__)
SHELLS = {"sh", "bash", "zsh", "fish", "dash", "nu"}

# ------------------------------------------------------------------ hook
def cmd_hook():
    try:
        d = json.load(sys.stdin)
    except Exception:
        return
    try:
        cwd = d.get("cwd") or os.getcwd()
        proj = core.project_for_cwd(cwd)
        ev = d.get("hook_event_name", "?")
        core.log_event({"harness": "claude", "event": ev, "session_id": d.get("session_id"), "cwd": cwd,
                        "project": proj, "transcript": d.get("transcript_path"),
                        "agent_id": d.get("agent_id"), "agent_type": d.get("agent_type"),
                        "agent_transcript": d.get("agent_transcript_path"),
                        "prompt": (d.get("prompt") or "")[:80] if ev == "UserPromptSubmit" else None})
        if ev == "SessionStart" and proj:
            mems = core.mem_recent(proj, 8)
            if mems:
                print(f"# Memória do projeto '{proj}' (Raid Point)\n"
                      "Use as ferramentas MCP raidpoint.memory_search / memory_add para consultar e registrar decisões.\n")
                for m in mems:
                    print(f"- [{m['kind']}] {m['text'][:240]}")
    except Exception:
        pass

# ------------------------------------------------------------------ MCP
def _proj(a):
    p = a.get("project") or core.project_for_cwd(os.getcwd())
    if not p or p not in core.load_projects():
        raise ValueError("projeto não encontrado; informe 'project' (veja list_projects)")
    return p

def t_list_projects(a):
    return {n: {"dir": p.get("dir"), "host": p.get("host")} for n, p in core.load_projects().items()}

def t_list_repos(a):
    if not core.gh_ok(): raise ValueError("gh não autenticado (rode: gh auth login)")
    return [{"repo": r["nameWithOwner"], "private": r["isPrivate"], "description": r.get("description"),
             "cloned": (core.workspace_path(r["nameWithOwner"]) / ".git").exists()} for r in core.gh_repos()]

def t_open_repo(a):
    path, err = core.ensure_workspace(a["repo"])
    if err: raise ValueError(err)
    return {"workspace": path}

def t_list_agents(a):
    p = _proj(a)
    panes = core.list_panes(p)
    for x in panes:
        x["status"] = "working" if x["idle_s"] < 4 else "idle"
        x["is_shell"] = x["cmd"] in SHELLS
    S = core.sessions(p)
    return {"project": p, "panes": panes,
            "ai_sessions": [{**s, "subagents": list(s.pop("subs").values())} for s in S.values()]}

def t_spawn_agent(a):
    p = _proj(a)
    presets = {x["name"].lower(): x for x in core.agents_cfg()}
    ag = presets.get(a.get("agent", "").lower())
    if not ag: raise ValueError(f"agente desconhecido; opções: {[x['name'] for x in core.agents_cfg()]}")
    if not ag["cmd"] and not core.ask_approval("spawn", p, "Abrir um painel de SHELL puro"):
        return {"error": "negado pelo usuário"}
    pid, d = core.spawn_pane(p, ag["name"], ag["cmd"], bool(a.get("worktree")))
    if not pid: return {"error": "não consegui criar o painel (sessão do projeto aberta no Raid Point?)"}
    if a.get("prompt") and ag["cmd"]:
        time.sleep(4)
        core.run_tmux(p, "send-keys", "-t", pid, "-l", a["prompt"]); core.run_tmux(p, "send-keys", "-t", pid, "Enter")
    return {"pane": pid, "dir": d, "agent": ag["name"]}

def t_send_message(a):
    p = _proj(a)
    pid = core.resolve_pane(p, a.get("target", ""))
    if not pid: raise ValueError("painel não encontrado (use id ou título de list_agents)")
    pane = next(x for x in core.list_panes(p) if x["id"] == pid)
    if pane["cmd"] in SHELLS and not core.ask_approval("send", p, f"Enviar a um SHELL ({pane['title']}):\n{a['text'][:300]}"):
        return {"error": "negado pelo usuário"}
    core.run_tmux(p, "send-keys", "-t", pid, "-l", a["text"])
    if a.get("enter", True): core.run_tmux(p, "send-keys", "-t", pid, "Enter")
    return {"sent": True, "pane": pid}

def t_read_output(a):
    p = _proj(a)
    pid = core.resolve_pane(p, a.get("target", ""))
    if not pid: raise ValueError("painel não encontrado")
    n = min(int(a.get("lines", 80)), 500)
    out = core.run_tmux(p, "capture-pane", "-p", "-t", pid, "-S", f"-{n}").stdout
    vals = [core.secret_get(p, s) or "" for s in core.secret_names(p)]
    return {"output": core.redact(out, vals)}

def t_memory_add(a):
    return {"saved": core.mem_add(_proj(a), a["text"], a.get("kind", "note"), a.get("tags", ""))}

def t_memory_search(a):
    return core.mem_search(_proj(a), a["query"], int(a.get("limit", 8)))

def t_memory_recent(a):
    return core.mem_recent(_proj(a), int(a.get("limit", 8)))

def t_secret_names(a):
    return {"names": core.secret_names(_proj(a)), "note": "valores nunca são retornados; use run_with_secrets"}

def t_run_with_secrets(a):
    return core.run_with_secrets(_proj(a), a["command"], a.get("secrets", []), a.get("purpose", ""))

_P = {"project": {"type": "string", "description": "nome do projeto Raid Point (opcional se o cwd estiver dentro de um)"}}
def _s(props, req=()):
    return {"type": "object", "properties": {**_P, **props}, "required": list(req)}
TOOLS = {
    "list_projects": ("Lista os projetos do Raid Point", _s({}), t_list_projects),
    "list_repos": ("Lista os repositórios do GitHub do usuário/orgs", _s({}), t_list_repos),
    "open_repo": ("Clona o repositório (dono/nome) em ~/.raid_point/workspaces/<repo> e devolve o caminho", _s({"repo": {"type": "string"}}, ["repo"]), t_open_repo),
    "list_agents": ("Lista painéis/agentes, sessões de IA e subagentes de um projeto", _s({}), t_list_agents),
    "spawn_agent": ("Abre um agente (preset do agents.json) em novo painel; worktree=true isola em git worktree",
                    _s({"agent": {"type": "string"}, "worktree": {"type": "boolean"}, "prompt": {"type": "string"}}, ["agent"]), t_spawn_agent),
    "send_message": ("Envia texto a um painel/agente (shell puro exige aprovação humana)",
                     _s({"target": {"type": "string"}, "text": {"type": "string"}, "enter": {"type": "boolean"}}, ["target", "text"]), t_send_message),
    "read_output": ("Lê as últimas linhas de um painel (segredos mascarados)",
                    _s({"target": {"type": "string"}, "lines": {"type": "integer"}}, ["target"]), t_read_output),
    "memory_add": ("Registra uma memória (decisão, bug, fato) do projeto",
                   _s({"text": {"type": "string"}, "kind": {"type": "string"}, "tags": {"type": "string"}}, ["text"]), t_memory_add),
    "memory_search": ("Busca full-text na memória do projeto", _s({"query": {"type": "string"}, "limit": {"type": "integer"}}, ["query"]), t_memory_search),
    "memory_recent": ("Memórias mais recentes do projeto", _s({"limit": {"type": "integer"}}), t_memory_recent),
    "secret_names": ("Nomes dos segredos do projeto (nunca os valores)", _s({}), t_secret_names),
    "run_with_secrets": ("Roda um comando com segredos injetados no ambiente, após aprovação humana; saída mascarada",
                         _s({"command": {"type": "string"}, "secrets": {"type": "array", "items": {"type": "string"}},
                             "purpose": {"type": "string"}}, ["command", "secrets"]), t_run_with_secrets),
}

def cmd_mcp():
    def send(o): sys.stdout.write(json.dumps(o, ensure_ascii=False) + "\n"); sys.stdout.flush()
    for line in sys.stdin:
        try: m = json.loads(line)
        except Exception: continue
        i, meth = m.get("id"), m.get("method")
        if meth == "initialize":
            send({"jsonrpc": "2.0", "id": i, "result": {"protocolVersion": m["params"].get("protocolVersion", "2024-11-05"),
                  "capabilities": {"tools": {}}, "serverInfo": {"name": "raidpoint", "version": "0.2"}}})
        elif meth == "tools/list":
            send({"jsonrpc": "2.0", "id": i, "result": {"tools": [
                {"name": n, "description": d, "inputSchema": sc} for n, (d, sc, _) in TOOLS.items()]}})
        elif meth == "tools/call":
            n, a = m["params"]["name"], m["params"].get("arguments") or {}
            try:
                res = TOOLS[n][2](a); err = False
            except Exception as e:
                res, err = {"error": str(e)}, True
            send({"jsonrpc": "2.0", "id": i, "result": {"isError": err or (isinstance(res, dict) and "error" in res),
                  "content": [{"type": "text", "text": json.dumps(res, ensure_ascii=False, indent=1, default=str)}]}})
        elif i is not None:
            send({"jsonrpc": "2.0", "id": i, "error": {"code": -32601, "message": "método desconhecido"}})

# ------------------------------------------------------------------ CLI auxiliar
def cmd_mem(a):
    sub = a[0] if a else ""
    if sub == "reindex": core.mem_reindex(); print("ok"); return
    proj = a[1] if len(a) > 1 else core.project_for_cwd(os.getcwd())
    if sub == "add": print(core.mem_add(proj, " ".join(a[2:])))
    elif sub == "search":
        for m in core.mem_search(proj, " ".join(a[2:])): print(f"[{m['kind']}] {m['ts']}  {m['text'][:200]}")
    elif sub == "recent":
        for m in core.mem_recent(proj): print(f"[{m['kind']}] {m['ts']}  {m['text'][:200]}")
    else: print(__doc__)

def cmd_secret(a):
    import getpass
    sub, proj = (a + ["", ""])[:2]; name = a[2] if len(a) > 2 else ""
    if sub == "set" and name:
        print("ok" if core.secret_set(proj, name, getpass.getpass(f"valor de {name}: ")) else "falhou")
    elif sub == "list": print("\n".join(core.secret_names(proj)))
    elif sub == "rm" and name: print("ok" if core.secret_rm(proj, name) else "falhou")
    else: print(__doc__)

def cmd_transcript(a):
    path, follow = a[0], "-f" in a
    def show(l):
        try: o = json.loads(l)
        except Exception: return
        msg = o.get("message") or {}; role = msg.get("role") or o.get("type", "?")
        c = msg.get("content")
        if isinstance(c, list):
            c = " ".join((x.get("text") or (f"[{x['name']}]" if x.get("type") == "tool_use" else "") or "") for x in c if isinstance(x, dict))
        if c: print(f"\033[35m{role:>9}\033[0m {str(c)[:600]}", flush=True)
    with open(path) as f:
        for l in f: show(l)
        while follow:
            l = f.readline()
            if l: show(l)
            else: time.sleep(0.5)

def cmd_install():
    # 1) hooks do Claude Code (remove os antigos do "termos")
    sp = os.path.expanduser("~/.claude/settings.json")
    s = json.load(open(sp)); shutil.copy(sp, sp + ".raidpoint.bak")
    hooks = s.setdefault("hooks", {})
    cmd = f"{SELF} hook"
    for ev, lst in list(hooks.items()):
        for g in lst:
            g["hooks"] = [h for h in g.get("hooks", []) if "/termos hook" not in h.get("command", "")]
        hooks[ev] = [g for g in lst if g.get("hooks")]
        if not hooks[ev]: del hooks[ev]
    for ev in ["SessionStart", "SessionEnd", "UserPromptSubmit", "Stop", "Notification", "SubagentStart", "SubagentStop"]:
        lst = hooks.setdefault(ev, [])
        if not any(cmd in h.get("command", "") for g in lst for h in g.get("hooks", [])):
            lst.append({"matcher": "", "hooks": [{"type": "command", "command": cmd, "timeout": 10}]})
    json.dump(s, open(sp, "w"), indent=2, ensure_ascii=False)
    print("hooks do Claude Code: ok (backup em settings.json.raidpoint.bak)")
    # 2) MCP no Claude Code
    subprocess.run(["claude", "mcp", "remove", "--scope", "user", "termos"], capture_output=True)
    r = subprocess.run(["claude", "mcp", "add", "--scope", "user", "raidpoint", "--", SELF, "mcp"], text=True, capture_output=True)
    print("MCP Claude Code:", (r.stdout + r.stderr).strip()[:160] or "ok")
    # 3) MCP no Codex
    import re as _re
    cp = os.path.expanduser("~/.codex/config.toml")
    if os.path.exists(cp):
        t = open(cp).read(); shutil.copy(cp, cp + ".raidpoint.bak")
        t = _re.sub(r"\n?\[mcp_servers\.(termos|raidpoint)\]\n(?:[^\[\n][^\n]*\n?)*", "", t)
        t += f'\n[mcp_servers.raidpoint]\ncommand = "{SELF}"\nargs = ["mcp"]\n'
        open(cp, "w").write(t); print("MCP Codex: ok")

# ------------------------------------------------------------------ projetos (terminal)
def _db():
    try: return json.load(open(core.CFG / "projects.json"))
    except Exception: return {}

def _save(d): json.dump(d, open(core.CFG / "projects.json", "w"), indent=2, ensure_ascii=False)

def _alive():
    r = subprocess.run(core.TMUX + ["list-sessions", "-F", "#{session_name}"], text=True, capture_output=True)
    return set(r.stdout.split()) if r.returncode == 0 else set()

def cmd_ls():
    on = _alive()
    for n, p in core.load_projects().items():
        print(f"{'●' if n in on else '○'} {n:<22} {p.get('host', '') + ':' if p.get('host') else ''}{p.get('dir', '')}")

def cmd_add(a):
    name = a[0]; d = os.path.abspath(os.path.expanduser(a[1])) if len(a) > 1 else os.getcwd()
    if subprocess.run(["git", "-C", d, "rev-parse"], capture_output=True).returncode != 0:
        if input(f"{d} não é um repositório git. Inicializar? [s/N] ").strip().lower() != "s":
            sys.exit("projetos do Raid Point precisam ser git. Abortado.")
        subprocess.run(["git", "-C", d, "init"], check=True)
    db = _db(); db[name] = {"dir": d, "startup": []}; _save(db); print(f"ok: {name} -> {d}")

def cmd_open(name):
    p = core.load_projects().get(name)
    if not p: sys.exit(f"projeto '{name}' não existe. Use: raidpoint add {name} [dir]")
    if p.get("host"):
        import shlex
        tm = ["tmux", "new-session", "-A", "-s", name] + (["-c", p["dir"]] if p.get("dir") else []) + [";", "set", "-g", "mouse", "on"]
        if p.get("transport", "mosh") == "mosh" and shutil.which("mosh"):
            os.execvp("mosh", ["mosh", p["host"], "--"] + tm)
        os.execvp("ssh", ["ssh", "-t", p["host"], shlex.join(tm)])
    d = os.path.expanduser(p["dir"])
    if name not in _alive():
        subprocess.run(core.TMUX + ["new-session", "-d", "-s", name, "-c", d], check=True)
    verb = "switch-client" if "/tp," in os.environ.get("TMUX", "") else "attach-session"
    os.execvp("tmux", core.TMUX + [verb, "-t", name])

def cmd_open_repo(nwo):
    path, err = core.ensure_workspace(nwo)
    if err: sys.exit(err)
    name = nwo.split("/")[1]; db = _db()
    db.setdefault(name, {"dir": path, "startup": [], "github": nwo}); _save(db); print(f"{name} -> {path}")

def main():
    a = sys.argv[1:]
    c = a[0] if a else ""
    if c == "hook": cmd_hook()
    elif c == "mcp": cmd_mcp()
    elif c == "mem": cmd_mem(a[1:])
    elif c == "secret": cmd_secret(a[1:])
    elif c == "transcript": cmd_transcript(a[1:])
    elif c == "install": cmd_install()
    elif c == "ls": cmd_ls()
    elif c == "add" and len(a) > 1: cmd_add(a[1:])
    elif c == "rm" and len(a) == 2:
        db = _db(); db.pop(a[1], None); _save(db)
    elif c == "kill" and len(a) == 2: subprocess.run(core.TMUX + ["kill-session", "-t", a[1]])
    elif c == "stop": subprocess.run(core.TMUX + ["kill-server"])
    elif c == "repos":
        if not core.gh_ok(): sys.exit("gh não autenticado: rode `gh auth login`")
        for r in core.gh_repos(force=True):
            print(f"{'●' if (core.workspace_path(r['nameWithOwner']) / '.git').exists() else '○'} {r['nameWithOwner']:<40} {'privado' if r['isPrivate'] else ''}")
    elif c == "open-repo" and len(a) == 2: cmd_open_repo(a[1])
    elif c == "events":
        for e in core.read_events()[-30:]: print(time.strftime("%H:%M:%S", time.localtime(e["ts"])), e.get("event"), e.get("project"), e.get("agent_type") or "", e.get("session_id", "")[:8])
    elif c in ("-h", "--help", "help", ""): print(__doc__)
    else: cmd_open(c[len("abrir "):] if c.startswith("abrir ") else (a[1] if c == "abrir" and len(a) > 1 else c))

if __name__ == "__main__":
    main()
