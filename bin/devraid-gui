        target = os.environ.get("RAIDPOINT_OPEN")
        self.open(target if target in ns else (db.get("_last") if db.get("_last") in ns else (ns[0] if ns else None)))

    def toggle_side(self):
        self.side.set_visible(not self.side.get_visible())

    def apply_ui_theme(self):
        """interface colors (theme + accent) and tmux colors (borders/tabs); applies immediately"""
        ui = core.ui_colors(self.cfg["terminal"])
        self.css.load_from_string(core.css_for(CSS + CHAT_CSS, ui))
        self.apply_tmux_theme()

    def apply_tmux_theme(self):
        ui = core.ui_colors(self.cfg["terminal"])
        def tmux_work():
            T = core.TMUX
            for opt, val in (("status-style", f"bg={ui['mantle']},fg={ui['overlay']}"), ("pane-border-style", f"fg={ui['s0']}"),
                             ("pane-active-border-style", f"fg={ui['accent']}"), ("message-style", f"bg={ui['s0']},fg={ui['text']}"),
                             ("window-status-current-format", f"#[bg={ui['bg']},fg={ui['accent']},bold]  #I  #W  "),
                             ("pane-border-format", f"#{{?pane_synchronized,#[fg={ui['yellow']}] ⇄ ,}}#[fg={ui['accent']},bold] "
                                                    "#{?#{==:#{pane_title},#{host}},Shell,#{pane_title}} ")):
                subprocess.run(T + ["set-option", "-g", opt, val], capture_output=True)
        threading.Thread(target=tmux_work, daemon=True).start()

    def apply_term_opts(self, term):
        t = self.cfg["terminal"]
        term.set_cursor_shape({"Bar": Vte.CursorShape.IBEAM, "Underline": Vte.CursorShape.UNDERLINE}.get(t.get("cursor"), Vte.CursorShape.BLOCK))
        term.set_cursor_blink_mode(Vte.CursorBlinkMode.ON if t.get("cursor_blink") else Vte.CursorBlinkMode.OFF)

    def rebuild_binds(self):
        self.binds = {}
        for act in ("zoom_in", "zoom_out", "zoom_reset", "copy", "paste"):
            acc = self.cfg.get("keys", {}).get(act, "")
            ok, kv, md = Gtk.accelerator_parse(acc) if acc else (False, 0, 0)
            if ok: self.binds[(Gdk.keyval_to_lower(kv), int(md))] = act

    def apply_accels(self):
        k = self.cfg.get("keys", {})
        for act, name in (("palette", "palette"), ("settings", "settings"), ("changes", "changes"),
                          ("agents_panel", "agents"), ("sidebar", "side"), ("chat", "chat")):
            acc = k.get(act, "")
            self.set_accels_for_action(f"app.{name}", [acc] if acc else [])

    def apply_theme(self, term):
        bg, fg, pal = core.THEMES.get(self.cfg["terminal"].get("theme"), core.THEMES["Catppuccin Mocha"])
        f, b = Gdk.RGBA(), Gdk.RGBA(); f.parse(fg); b.parse(bg)
        colors = []
        for h in pal.split():
            c = Gdk.RGBA(); c.parse(h); colors.append(c)
        term.set_colors(f, b, colors)

    def names(self):
        return [n for n, v in load().items() if isinstance(v, dict) and not n.startswith("_")]

    def avatar(self, name):
        """small colored square with the initial (each color's CSS provider is created only once)"""
        av = Gtk.Label(label=name[0].upper(), halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        av.add_css_class("avatar")
        cls = "av" + hashlib.md5(name.encode()).hexdigest()[:8]
        if cls not in self._av_css:
            self._av_css.add(cls)
            p = Gtk.CssProvider(); p.load_from_string(f".{cls} {{ background: {color(name)}; }}")
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        av.add_css_class(cls)
        return av

    def warn_projects_error(self):
        err = core.projects_error()
        if err and not getattr(self, "_err_proj", False):
            self._err_proj = True
            Gtk.AlertDialog(message="Could not read the project list",
                            detail=f"{core.PROJ}\n\n{err}\n\nYour projects were NOT deleted: the file just has a format error. "
                                   "Fix the JSON (or restore a backup) and reopen the app. Until then the app won't write to it.").show(self.win)
        elif not err: self._err_proj = False

    def refresh_list(self):
        self.warn_projects_error()
        while (r := self.list.get_first_child()): self.list.remove(r)
        self.rows = {}; self.badges = {}; on = alive(); db = load()
        for n in self.names():
            row = Gtk.ListBoxRow(); row.name = n
            box = Gtk.Box(spacing=10)
            av = self.avatar(n)
            name_lbl = Gtk.Label(label=n, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
            name_lbl.add_css_class("name-lbl")
            dot = Gtk.Label(label="●")
            dot.add_css_class("dot-remote" if db[n].get("host") else ("dot-on" if core.sess(n) in on else "dot-off"))
            badge = Gtk.Label(label=""); self.badges[n] = badge
            box.append(av); box.append(name_lbl); box.append(badge); box.append(dot)
            row.set_child(box); self.list.append(row); self.rows[n] = (row, dot)
            if n == self.cur: self.list.select_row(row)
        self.update_badges()

    def tick(self):
        on = alive(); db = load()
        for n, (_, dot) in self.rows.items():
            if db.get(n, {}).get("host"): continue
            dot.remove_css_class("dot-on"); dot.remove_css_class("dot-off")
            dot.add_css_class("dot-on" if core.sess(n) in on else "dot-off")
        return True

    def open(self, name):
        p = load().get(name) if name else None
        if not p:
            self.title_lbl.set_label("/dev/raid"); return
        if name not in self.terms:
            term = Vte.Terminal(hexpand=True, vexpand=True)
            term.set_scrollback_lines(0)
            term.set_font(Pango.FontDescription(self.cfg['terminal']['font'])); term.set_font_scale(self.zoom)
            self.apply_theme(term)
            self.apply_term_opts(term)
            self.setup_term_extras(term, name)
            kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            kc.connect("key-pressed", lambda c, kv, kcode, st, n=name: self.on_term_key(n, kv, st))
            term.add_controller(kc)
            sc = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
            sc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            def zscroll(c, dx, dy):
                if not (c.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK): return False
                self.set_zoom(self.zoom - float(self.cfg['terminal'].get('zoom_step', 0.1)) * (1 if dy > 0 else -1)); return True
            sc.connect("scroll", zscroll); term.add_controller(sc)
            term.connect("child-exited", lambda t, s, n=name: self.on_child_exit(n))
            self.terms[name] = term; self.stack.add_named(term, name); self.spawn(name)
        self.cur = name
        self.chat.on_project_changed()
        self.attn.pop(name, None); self.update_badges()
        self.stack.set_visible_child_name(name)
        self.terms[name].grab_focus()
        setp(lambda d: d.__setitem__("_last", name))
        self.set_sync_ui(name, False); self.refresh_sync(name)
        where = f"{p['host']}:{p.get('dir') or '~'}" if p.get("host") else p["dir"].replace(os.path.expanduser("~"), "~")
        self.title_lbl.set_label(f"{name}  —  {where}")
        if name in self.rows: self.list.select_row(self.rows[name][0])

    def spawn(self, name):
        GLib.timeout_add(1800, lambda: (self.apply_tmux_theme(), False)[1])
        p = load().get(name)
        if not p or name not in self.terms: return
        env = [f"{k}={v}" for k, v in os.environ.items() if k != "TMUX"]
        env += ["TERM=xterm-256color", "COLORTERM=truecolor"]
        if p.get("host"):
            argv, cwd = core.remote_argv(name, p), os.path.expanduser("~")
        else:
            d = os.path.expanduser(p["dir"])
            argv, cwd = TMUX + ["new-session", "-A", "-s", core.sess(name), "-c", d], (d if os.path.isdir(d) else os.path.expanduser("~"))
        self._spawn_t[name] = time.time()
        self.terms[name].spawn_async(Vte.PtyFlags.DEFAULT, cwd, argv, env,
            GLib.SpawnFlags.SEARCH_PATH, None, None, -1, None, None)

    def on_child_exit(self, name):
        """the tmux/ssh/mosh client exited: reopen it. If it died right after opening, wait 5s (no restart loop)"""
        if name not in self.terms or name in self._respawn: return
        if time.time() - self._spawn_t.get(name, 0) >= 4:
            self.spawn(name); return
        self._respawn.add(name)
        self.terms[name].feed("\r\n\x1b[33m[/dev/raid] the connection dropped right after opening; retrying in 5s…\x1b[0m\r\n".encode())
        def again():
            self._respawn.discard(name); self.spawn(name); return False
        GLib.timeout_add_seconds(5, again)

    def t(self, *cmd):
        if not self.cur: return
        proj = self.cur; d = pdir(proj)
        extra = ["-c", d] if d and cmd[0] in ("split-window", "new-window") else []
        target = core.tgt(proj)
        threading.Thread(target=lambda: run_tmux(proj, cmd[0], "-t", target, *cmd[1:], *extra), daemon=True).start()
        self.terms[proj].grab_focus()

    def set_layout(self, lay):
        self.layout = lay
        if self.cur:
            proj = self.cur
            threading.Thread(target=lambda: run_tmux(proj, "select-layout", "-t", core.tgt(proj), lay), daemon=True).start()
            self.terms[proj].grab_focus()

    def add_pane(self, title, cmd, worktree=False):
        if not self.cur: return
        proj = self.cur
        def work():
            pid, d, err = core.spawn_pane(proj, title, cmd, worktree, self.layout)
            GLib.idle_add(self.after_pane, proj, err)
        threading.Thread(target=work, daemon=True).start()

    def after_pane(self, proj, err):
        if err: Gtk.AlertDialog(message="Could not open the pane", detail=err).show(self.win)
        elif proj in self.terms: self.terms[proj].grab_focus()
        return False

    def add_agent(self, ag, worktree=False):
        self.add_pane(ag["name"], ag["cmd"], worktree)

    def toggle_sync(self):
        if not self.cur: return
        proj = self.cur
        def work():
            r = run_tmux(proj, "show-options", "-wv", "-t", core.tgt(proj), "synchronize-panes").stdout.strip()
            new = "off" if r == "on" else "on"
            run_tmux(proj, "set-option", "-w", "-t", core.tgt(proj), "synchronize-panes", new)
            GLib.idle_add(self.set_sync_ui, proj, new == "on")
        threading.Thread(target=work, daemon=True).start()
        self.terms[proj].grab_focus()

    def set_sync_ui(self, proj, on):
        if proj == self.cur:
            self.sync_on = on
            (self.menu_btn.add_css_class if on else self.menu_btn.remove_css_class)("sync-on")
        return False

    def refresh_sync(self, proj):
        def work():
            r = run_tmux(proj, "show-options", "-wv", "-t", core.tgt(proj), "synchronize-panes").stdout.strip()
            GLib.idle_add(self.set_sync_ui, proj, r == "on")
        threading.Thread(target=work, daemon=True).start()

    # ---------- copy and paste
    def set_clipboard(self, txt):
        d = Gdk.Display.get_default()
        d.get_clipboard().set(txt)
        try: d.get_primary_clipboard().set(txt)
        except Exception: pass

    def on_term_key(self, name, keyval, state):
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK); shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        term = self.terms.get(name)
        if not term: return False
        mods = int(state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK
                            | Gdk.ModifierType.ALT_MASK | Gdk.ModifierType.SUPER_MASK))
        kv = Gdk.keyval_to_lower(keyval)
        act = self.binds.get((kv, mods)) or self.binds.get((kv, mods & ~int(Gdk.ModifierType.SHIFT_MASK)))
        if not act and kv in (Gdk.KEY_equal, Gdk.KEY_KP_Add):      # "+" without Shift (=) also zooms in
            act = self.binds.get((Gdk.KEY_plus, mods & ~int(Gdk.ModifierType.SHIFT_MASK)))
        step = float(self.cfg["terminal"].get("zoom_step", 0.1))
        if act == "zoom_in": self.set_zoom(self.zoom + step); return True
        if act == "zoom_out": self.set_zoom(self.zoom - step); return True
        if act == "zoom_reset": self.set_zoom(1.0); return True
        if act == "copy": self.do_copy(name); return True
        if act == "paste": term.paste_clipboard(); return True
        if (ctrl and not shift and keyval == Gdk.KEY_Insert): self.do_copy(name); return True
        if shift and not ctrl and keyval == Gdk.KEY_Insert: term.paste_clipboard(); return True
        return False

    def set_zoom(self, z):
        self.zoom = round(max(0.5, min(3.0, z)), 2)
        for t in self.terms.values(): t.set_font_scale(self.zoom)
        setp(lambda d: d.__setitem__("_zoom", self.zoom))

    def do_copy(self, name):
        term = self.terms.get(name)
        if not term: return
        if term.get_has_selection():           # native selection (Shift+drag)
            term.copy_clipboard_format(Vte.Format.TEXT)
        else:                                  # otherwise: the last text copied inside tmux
            def work():
                r = core.run_tmux(name, "show-buffer", timeout=5)
                if r.returncode == 0 and r.stdout: GLib.idle_add(self.set_clipboard, r.stdout)
            threading.Thread(target=work, daemon=True).start()

    # ---------- links and right-click menu
    def setup_term_extras(self, term, name):
        term.set_allow_hyperlink(True)
        try:
            tag = term.match_add_regex(Vte.Regex.new_for_match(URL_RE, -1, 0x400), 0)  # 0x400 = PCRE2_MULTILINE
            term.match_set_cursor_name(tag, "pointer")
        except Exception as e:
            print("warning: link detection unavailable:", e, file=sys.stderr)
        # Ctrl+click opens the link (captured before tmux/the application)
        gl = Gtk.GestureClick(button=1); gl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def left(g, n, x, y):
            if not (g.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK): return
            u = self.link_at(term, x, y)
            if u:
                g.set_state(Gtk.EventSequenceState.CLAIMED); self.open_uri(u)
        gl.connect("pressed", left); term.add_controller(gl)
        # right button: our own menu (works even inside tmux/TUIs that capture the mouse)
        gr = Gtk.GestureClick(button=3); gr.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def right(g, n, x, y):
            g.set_state(Gtk.EventSequenceState.CLAIMED); self.show_ctx(name, term, x, y)
        gr.connect("pressed", right); term.add_controller(gr)

    def link_at(self, term, x, y):
        try:
            u = term.check_hyperlink_at(x, y)
            if u: return u
            m = term.check_match_at(x, y)
            m = m[0] if isinstance(m, (tuple, list)) else m
            if m: return m if re.match(r"[a-z]+://", m) else "https://" + m
        except Exception:
            pass
        return None

    # ---------- command palette (Ctrl+D): the whole app, by keyboard
    def commands(self):
        step = float(self.cfg["terminal"].get("zoom_step", 0.1))
        C = []
        def add(label, hint, fn): C.append((label, hint, fn))
        for ag in agents():
            add(f"Agent: {ag['name']}", "new pane", lambda ag=ag: self.add_agent(ag))
            if ag.get("cmd"):
                add(f"Agent: {ag['name']} in isolated worktree", "own branch", lambda ag=ag: self.add_agent(ag, True))
        add("Pane: new shell", "uses the layout", lambda: self.add_pane("Shell", ""))
        add("Pane: new tab", "", lambda: self.t("new-window"))
        add("Pane: zoom", "Alt+z", lambda: self.t("resize-pane", "-Z"))
        add("Pane: close", "Alt+w", lambda: self.t("kill-pane"))
        add("Panes: type in all " + ("(on ✓)" if self.sync_on else ""), "", self.toggle_sync)
        for label, lay in [("columns (side by side)", "even-horizontal"), ("rows (stacked)", "even-vertical"),
                           ("grid", "tiled"), ("main on the left", "main-vertical"), ("main on top", "main-horizontal")]:
            add(f"Layout: {label}", "", lambda l=lay: self.set_layout(l))
        add("Orchestrate: parallel task…", "several agents, 1 task", self.on_parallel)
        add("Orchestrate: open orchestrator agent", "it splits the work and spawns subagents", self.open_orchestrator)
        add("Changes: view diff and commit", "Ctrl+G", self.on_changes)
        add("Agents panel: show/hide", "Ctrl+J", self.toggle_agents)
        add("Orchestrator: chat", "Ctrl+Shift+K", self.toggle_chat)
        add("Project list: show/hide", "Ctrl+B", self.toggle_side)
        add("Project secrets…", "", self.on_secrets)
        add("Project: remove…", "", self.on_remove)
        add("Text: larger", "Ctrl +", lambda: self.set_zoom(self.zoom + step))
        add("Text: smaller", "Ctrl −", lambda: self.set_zoom(self.zoom - step))
        add("Text: normal size", "Ctrl 0", lambda: self.set_zoom(1.0))
        add("Settings", "Ctrl+,", self.on_settings)
        add("Settings: open config.toml (advanced)", "", self.open_config)
        add("Check for updates", f"v{core.VERSION}", lambda: self.update_tick(force=True))
        add("Restart /dev/raid", "apply an update", self.restart)
        for n in self.names():
            add(f"Project: {n}", "open", lambda n=n: self.open(n))
        return C

    def palette(self, initial=""):
        import unicodedata
        norm = lambda t: "".join(c for c in unicodedata.normalize("NFD", t.lower()) if not unicodedata.combining(c))
        w = Gtk.Window(title="Commands", transient_for=self.win, modal=True, default_width=560, default_height=420, resizable=False)
        entry = Gtk.SearchEntry(placeholder_text="Type a command… (↑ ↓ Enter, Esc closes)", margin_top=10, margin_start=10, margin_end=10)
        lst = Gtk.ListBox(); lst.add_css_class("rp-list")
        sc = Gtk.ScrolledWindow(vexpand=True, margin_top=8, margin_bottom=10, margin_start=10, margin_end=10,
                                hscrollbar_policy=Gtk.PolicyType.NEVER)
        sc.set_child(lst)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.append(entry); box.append(sc); w.set_child(box)
        cmds = self.commands()

        def fill(*_):
            q = norm(entry.get_text()).split()
            while (r := lst.get_first_child()): lst.remove(r)
            for label, hint, fn in cmds:
                if all(t in norm(label) for t in q):
                    r = Gtk.ListBoxRow(); r.fn = fn
                    h = Gtk.Box(spacing=8, margin_top=3, margin_bottom=3, margin_start=6, margin_end=6)
                    h.append(Gtk.Label(label=label, xalign=0, hexpand=True))
                    if hint:
                        l = Gtk.Label(label=hint); l.add_css_class("ag-sub"); h.append(l)
                    r.set_child(h); lst.append(r)
            first = lst.get_row_at_index(0)
            if first: lst.select_row(first)

        def run(row=None):
            row = row or lst.get_selected_row()
            if not row: return
            w.close()
            GLib.idle_add(lambda: (row.fn(), False)[1])

        def move(d):
            row = lst.get_selected_row(); i = (row.get_index() if row else -1) + d
            nxt = lst.get_row_at_index(max(0, i))
            if nxt: lst.select_row(nxt); nxt.grab_focus(); entry.grab_focus()

        entry.connect("search-changed", fill); entry.connect("activate", lambda *_: run())
        lst.connect("row-activated", lambda l, r: run(r))
        kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def key(c, kv, kcode, st):
            if kv == Gdk.KEY_Escape: w.close(); return True
            if kv == Gdk.KEY_Down: move(1); return True
            if kv == Gdk.KEY_Up: move(-1); return True
            return False
        kc.connect("key-pressed", key); w.add_controller(kc)
        w.connect("close-request", lambda *_: (self.terms.get(self.cur) and GLib.idle_add(lambda: (self.terms[self.cur].grab_focus(), False)[1]), False)[1])
        entry.set_text(initial); fill(); w.present(); entry.grab_focus(); entry.set_position(-1)

    # ---------- orchestration: the same task in several agents, each in its own worktree
    def open_orchestrator(self):
        """Claude (or the first agent that accepts a task as an argument) with the orchestrator instruction: it uses MCP to
        split the work and spawn subagents in worktrees."""
        if not self.cur: return
        ags = [a for a in agents() if a.get("cmd")]
        ag = next((a for a in ags if a["name"].lower() == "claude"), None) or next(
            (a for a in ags if os.path.basename((shlex.split(a["cmd"]) or [""])[0]) in core.PROMPT_ARG), None)
        if not ag:
            Gtk.AlertDialog(message="No agent to orchestrate", detail="Add Claude (or another agent that accepts an initial task) in Settings → Agents.").show(self.win); return
        cmd, _ = core.agent_launch_cmd(ag, core.ORCHESTRATOR_PROMPT)
        proj = self.cur
        def work():
            pid, d, err = core.spawn_pane(proj, "Orchestrator", cmd, False, self.layout)
            GLib.idle_add(self.after_pane, proj, err)
        threading.Thread(target=work, daemon=True).start()

    def on_parallel(self, *_):
        if not self.cur: return
        proj = self.cur; p = load().get(proj) or {}
        remote = bool(p.get("host"))
        ags = [a for a in agents() if a.get("cmd")]
        w = Gtk.Window(title="Parallel task", transient_for=self.win, modal=True, default_width=640, default_height=540)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=16, margin_bottom=16, margin_start=18, margin_end=18)
        info = Gtk.Label(xalign=0, wrap=True, label="Describe the task once; each selected agent gets the same text and works on its own. "
                                                    "Then compare the results in Changes (Ctrl+G).")
        info.add_css_class("ag-sub"); box.append(info)
        tv = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=8, right_margin=8, top_margin=8, bottom_margin=8, vexpand=True)
        if os.environ.get("RAIDPOINT_PARALLEL_TEXT"): tv.get_buffer().set_text(os.environ["RAIDPOINT_PARALLEL_TEXT"])   # screenshots
        sc = Gtk.ScrolledWindow(vexpand=True, min_content_height=150); sc.set_child(tv); box.append(sc)
        t = Gtk.Label(label="AGENTS  (how many copies of each)", xalign=0); t.add_css_class("ag-sec"); box.append(t)
        spins = {}
        default = [a["name"] for a in ags if a["name"].lower() in ("claude", "codex")] or [a["name"] for a in ags[:1]]
        for a in ags:
            h = Gtk.Box(spacing=10)
            h.append(Gtk.Label(label=a["name"], xalign=0, hexpand=True))
            sp = Gtk.SpinButton.new_with_range(0, 4, 1); sp.set_value(1 if a["name"] in default else 0)
            spins[a["name"]] = sp; h.append(sp); box.append(h)
        wt = Gtk.CheckButton(label="Isolate each agent in a git worktree (recommended)", active=not remote, sensitive=not remote)
        if remote: wt.set_tooltip_text("Worktrees don't work in remote projects")
        box.append(wt)
        st = Gtk.Label(xalign=0, wrap=True); st.add_css_class("ag-sub"); box.append(st)
        go = Gtk.Button(label="Launch agents", halign=Gtk.Align.END); go.add_css_class("agent"); box.append(go)
        w.set_child(box)

        def launch(*_):
            b = tv.get_buffer(); prompt = b.get_text(b.get_start_iter(), b.get_end_iter(), False).strip()
            names = [n for n, sp in spins.items() for _ in range(int(sp.get_value()))]
            if not prompt: st.set_label("Write the task."); return
            if not names: st.set_label("Select at least one agent (copies > 0)."); return
            go.set_sensitive(False); st.set_label(f"Opening {len(names)} agent(s)…")
            def work():
                res = core.run_task(proj, prompt, names, wt.get_active(), self.layout)
                GLib.idle_add(finish, res)
            def finish(res):
                errors = [f"{r['agent']}: {r['error']}" for r in res if r["error"]]
                if errors:
                    st.set_label("Some failed to open:\n" + "\n".join(errors)); go.set_sensitive(True)
                else:
                    w.close()
                    if proj in self.terms: self.terms[proj].grab_focus()
                return False
            threading.Thread(target=work, daemon=True).start()
        go.connect("clicked", launch)
        kc = Gtk.EventControllerKey(); kc.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def key(c, kv, kcode, stt):
            if kv == Gdk.KEY_Escape: w.close(); return True
            if kv in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and stt & Gdk.ModifierType.CONTROL_MASK: launch(); return True
            return False
        kc.connect("key-pressed", key); w.add_controller(kc)
        w.present(); tv.grab_focus()

    # ---------- Settings (visual, VS Code style); saves automatically on every change
    def on_settings(self, *_):
        for x in Gtk.Window.list_toplevels():
            if x.get_title() == "Settings": x.present(); return
        w = Gtk.Window(title="Settings", transient_for=self.win, default_width=900, default_height=600)
        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True, vexpand=True)
        side = Gtk.StackSidebar(stack=stack, width_request=190)
        root = Gtk.Box(); root.append(side); root.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)); root.append(stack)
        w.set_child(root)

        def page(page_id, title, sub=""):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=22, margin_bottom=22, margin_start=28, margin_end=28)
            t = Gtk.Label(label=title, xalign=0); t.add_css_class("title-1"); box.append(t)
            if sub:
                l = Gtk.Label(label=sub, xalign=0, wrap=True); l.add_css_class("ag-sub"); box.append(l)
            sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER); sc.set_child(box)
            stack.add_titled(sc, page_id, title); return box

        def row(box, label, hint, widget):
            h = Gtk.Box(spacing=12)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
            a = Gtk.Label(label=label, xalign=0); v.append(a)
            if hint:
                d = Gtk.Label(label=hint, xalign=0, wrap=True); d.add_css_class("ag-sub"); v.append(d)
            h.append(v); widget.set_valign(Gtk.Align.CENTER); h.append(widget); box.append(h)

        def save(): core.save_config(self.cfg)

        # --- Terminal
        t = page("terminal", "Terminal", "How text looks in the panes. Applies immediately.")
        # our own font picker (Gtk.FontDialog hangs/crashes the app without a desktop portal)
        from gi.repository import PangoCairo
        fdesc = Pango.FontDescription(self.cfg["terminal"]["font"])
        fs = {"fam": fdesc.get_family() or "Noto Sans Mono", "size": int(round(fdesc.get_size() / Pango.SCALE)) or 11, "ready": False}
        try:
            mono_name = re.compile(r"mono|code|courier|consol|terminal|typewriter|hack|fira ?code|iosevka|cascadia|menlo", re.I)
            fams = sorted({f.get_name() for f in PangoCairo.FontMap.get_default().list_families()
                           if f.is_monospace() or mono_name.search(f.get_name())}, key=str.lower)
        except Exception: fams = []
        if fs["fam"] not in fams: fams.insert(0, fs["fam"])
        def font_changed():
            if not fs["ready"]: return
            self.cfg["terminal"]["font"] = f"{fs['fam']} {fs['size']}"; save()
            for tm in self.terms.values(): tm.set_font(Pango.FontDescription(self.cfg["terminal"]["font"]))
        search = Gtk.SearchEntry(placeholder_text="Search monospace fonts…")
